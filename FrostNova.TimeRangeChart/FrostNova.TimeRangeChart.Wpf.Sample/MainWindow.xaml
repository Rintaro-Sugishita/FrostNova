<Window
    x:Class="FrostNova.TimeRangeChart.Wpf.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:FrostNova.TimeRangeChart.Wpf;assembly=FrostNova.TimeRangeChart.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf.Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Name="mainWindow"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeChartStyle.xaml" />
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/GridTimeRangeChartStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <sys:TimeSpan x:Key="minSpan">1.0:0:0</sys:TimeSpan>



                <Style
                    x:Key="rangeStyle"
                    BasedOn="{StaticResource timeRangeControlStyle}"
                    TargetType="chart:TimeRangeControl">
                    <Setter Property="StartTime" Value="{Binding StartTime}" />
                    <Setter Property="EndTime" Value="{Binding EndTime}" />
                    <Setter Property="WorkingSpan" Value="{Binding WorkingSpan}" />
                    <Setter Property="ActualSpan" Value="{Binding ActualSpan}" />
                    <Setter Property="MinSpan" Value="{Binding MinSpan}" />
                    <Setter Property="IsMilestone" Value="False" />
                    <Setter Property="CanDrag" Value="True" />
                    <Setter Property="CanExpandSpan" Value="True" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <!--<Setter Property="IsExpandThumbAnyTimeVisible" Value="True" />-->
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{Binding Color}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate DataType="{x:Type local:SampleModel}">
                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StartTime, StringFormat=MM/dd}" />
                                        <TextBlock Text="(" />
                                        <TextBlock Text="{Binding ActualSpan.Days}" />
                                        <TextBlock Text=")" />
                                        <TextBlock Text="{Binding WorkingSpan.Days}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding MinSpan}" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>


                </Style>



            </ResourceDictionary>
        </Grid.Resources>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{StaticResource PageUris}" Name="pageList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <Frame Grid.Column="2" Source="{Binding ElementName=pageList, Path=SelectedItem.PageUri}"
               NavigationUIVisibility="Hidden"

               >

        </Frame>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SetDataCommand}" Content="データセット" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="grid">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>


                    <chart:GridTimeRangeChart
                        x:Name="gridChart"
                        Background="#ddddff"
                        CanDragTasksBetweenRows="True"
                        EndTime="{Binding GridVm.ChartEnd}"
                        HeaderFormat="yyyy/MM/dd"
                        ItemsSource="{Binding GridVm.ModelList}"
                        MinRowWidth="200"
                        MinSpan="{StaticResource minSpan}"
                        NonWorkingRangeBackground="#eecccc"
                        RowHeight="150"
                        RuledLineFill="Gray"
                        RuledLineThickness="0.5"
                        ScaleIncrement="{StaticResource minSpan}"
                        StartTime="{Binding GridVm.ChartStart}"
                        TimeRangeStyle="{StaticResource rangeStyle}"
                        WidthPerRuledLine="100">
                        <chart:GridTimeRangeChart.CornerHeaderSource>
                            <TextBlock Text="aaaa" />
                        </chart:GridTimeRangeChart.CornerHeaderSource>
                        <chart:GridTimeRangeChart.RowHeaderTemplate>
                            <DataTemplate DataType="{x:Type local:GridSampleData}">
                                <TextBlock Height="150" Text="{Binding Name}" />
                            </DataTemplate>
                        </chart:GridTimeRangeChart.RowHeaderTemplate>
                        <chart:GridTimeRangeChart.ChartStyle>
                            <Style TargetType="{x:Type chart:TimeRangeChart}">
                                <Setter Property="ItemsSource" Value="{Binding Tasks}" />
                                <Setter Property="NonWorkingTimes" Value="{Binding ElementName=mainWindow, Path=DataContext.GridVm.NonWorkingTimes}" />
                            </Style>
                        </chart:GridTimeRangeChart.ChartStyle>

                    </chart:GridTimeRangeChart>
                    <GridSplitter
                        Grid.Column="1"
                        Width="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Columns" />
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="scroll top: " />
                            <TextBlock Text="{Binding ElementName=gridChart, Path=ScrollTopItem.Name}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="scroll left: " />
                            <TextBlock Grid.Row="1" Text="{Binding ElementName=gridChart, Path=ScrollLeftDate.DateValue, StringFormat='yyyy-MM-dd'}" />

                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="scroll center: " />
                            <TextBlock Grid.Row="1" Text="{Binding ElementName=gridChart, Path=ScrollCenterDate.DateValue, StringFormat='yyyy-MM-dd'}" />

                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="scroll bottom: " />
                            <TextBlock Text="{Binding ElementName=gridChart, Path=ScrollBottomItem.Name}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="scroll right: " />
                            <TextBlock Text="{Binding ElementName=gridChart, Path=ScrollRightDate.DateValue, StringFormat='yyyy-MM-dd'}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="month grid" Visibility="Collapsed">

                <chart:GridTimeRangeChart
                    EndTime="{Binding MonthGridVm.ChartEnd}"
                    HeaderFormat="yyyy/MM"
                    ItemsSource="{Binding MonthGridVm.ModelList}"
                    MinRowWidth="200"
                    MinSpan="{StaticResource minSpan}"
                    MonthSpan="1"
                    NonWorkingRangeBackground="#e0e0e0"
                    RowHeight="150"
                    RuledLineFill="Gray"
                    RuledLineThickness="0.5"
                    ScaleIncrement="{StaticResource minSpan}"
                    StartTime="{Binding MonthGridVm.ChartStart}"
                    TimeRangeStyle="{StaticResource rangeStyle}"
                    TimeUnit="Month"
                    WidthPerRuledLine="200">
                    <chart:GridTimeRangeChart.CornerHeaderSource>
                        <TextBlock Text="aaaa" />
                    </chart:GridTimeRangeChart.CornerHeaderSource>
                    <chart:GridTimeRangeChart.RowHeaderTemplate>
                        <DataTemplate DataType="{x:Type local:GridSampleData}">
                            <TextBlock Height="150" Text="{Binding Name}" />
                        </DataTemplate>
                    </chart:GridTimeRangeChart.RowHeaderTemplate>
                    <chart:GridTimeRangeChart.ChartStyle>
                        <Style TargetType="{x:Type chart:TimeRangeChart}">
                            <Setter Property="ItemsSource" Value="{Binding Tasks}" />
                            <Setter Property="NonWorkingTimes" Value="{Binding ElementName=mainWindow, Path=DataContext.MonthGridVm.NonWorkingTimes}" />
                        </Style>
                    </chart:GridTimeRangeChart.ChartStyle>

                </chart:GridTimeRangeChart>
            </TabItem>
            <TabItem Header="chart" Visibility="Collapsed">
                <chart:TimeRangeChart
                    EndTime="{Binding ChartVm.ChartEnd}"
                    ItemsSource="{Binding ChartVm.Model.Tasks}"
                    MinSpan="{StaticResource minSpan}"
                    NonWorkingTimes="{Binding ChartVm.NonWorkingTimes}"
                    RuledLineFill="Gray"
                    RuledLineThickness="0.5"
                    ScaleIncrement="{StaticResource minSpan}"
                    StartTime="{Binding ChartVm.ChartStart}">
                    <chart:TimeRangeChart.TimeRangeStyle>
                        <Style BasedOn="{StaticResource {x:Type chart:TimeRangeControl}}" TargetType="{x:Type chart:TimeRangeControl}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{Binding Color}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Height" Value="60" />
                            <Setter Property="StartTime" Value="{Binding StartTime}" />
                            <Setter Property="EndTime" Value="{Binding EndTime}" />
                            <Setter Property="WorkingSpan" Value="{Binding WorkingSpan}" />
                            <Setter Property="CanExpandSpan" Value="True" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,30,0,10" />
                            <Setter Property="IsMilestone" Value="True" />
                            <Setter Property="Width" Value="20" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="MilestoneType" Value="Circle" />

                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate DataType="{x:Type local:SampleModel}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ClipToBounds="False"
                                            FontSize="10"
                                            Text="{Binding WorkingSpan}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StartTime}" />
                                        </StackPanel>
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </chart:TimeRangeChart.TimeRangeStyle>
                </chart:TimeRangeChart>

            </TabItem>
            <TabItem Header="holiday" Visibility="Collapsed">
                <chart:GridTimeRangeChart
                    EndTime="{Binding HolidayVM.EndTime}"
                    HeaderFormat="MM/dd"
                    ItemsSource="{Binding HolidayVM.Items}"
                    MinSpan="{StaticResource minSpan}"
                    RowHeight="200"
                    RuledLineFill="Gray"
                    ScaleIncrement="{StaticResource minSpan}"
                    StartTime="{Binding HolidayVM.StartTime}"
                    TimeUnit="Normal"
                    WidthPerRuledLine="100">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewTaskDrop">
                            <i:InvokeCommandAction Command="{Binding}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <chart:GridTimeRangeChart.ChartStyle>
                        <Style BasedOn="{StaticResource {x:Type chart:TimeRangeChart}}" TargetType="{x:Type chart:TimeRangeChart}">
                            <Setter Property="NonWorkingTimes" Value="{Binding ElementName=mainWindow, Path=DataContext.HolidayVM.NonWorkingTimes}" />
                            <Setter Property="ItemsSource" Value="{Binding Tasks}" />
                        </Style>
                    </chart:GridTimeRangeChart.ChartStyle>
                    <chart:GridTimeRangeChart.RowHeaderTemplate>
                        <DataTemplate DataType="{x:Type local:GridSampleData}">
                            <TextBlock Height="200" Text="{Binding Name}" />
                        </DataTemplate>
                    </chart:GridTimeRangeChart.RowHeaderTemplate>
                    <chart:GridTimeRangeChart.TimeRangeStyle>
                        <Style BasedOn="{StaticResource rangeStyle}" TargetType="{x:Type chart:TimeRangeControl}">
                            <Setter Property="Background" Value="Orange" />
                            <Setter Property="Height" Value="60" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate DataType="{x:Type local:SampleModel}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StartTime, StringFormat='yyyy/MM/dd'}" />

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Actual :   " />
                                                <TextBlock Text="{Binding ActualSpan}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Working: " />
                                                <TextBlock Text="{Binding WorkingSpan}" />
                                            </StackPanel>

                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </chart:GridTimeRangeChart.TimeRangeStyle>
                </chart:GridTimeRangeChart>
            </TabItem>
        </TabControl>


    </Grid>
</Window>
