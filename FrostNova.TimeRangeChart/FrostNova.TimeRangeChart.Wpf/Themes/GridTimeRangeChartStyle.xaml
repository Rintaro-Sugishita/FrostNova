<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
    xmlns:cnv="clr-namespace:FrostNova.Core.Wpf.Converters;assembly=FrostNova.Core.Wpf"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wpfCommon="clr-namespace:FrostNova.Core.Wpf.Common;assembly=FrostNova.Core.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cnv:DateTimeFormatConverter x:Key="dateConverter" />
    <cnv:BorderThicknessConverter x:Key="borderThicknessConverter" />


    <Style x:Key="virtualContainerListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="false"
                      Padding="0"
                                  x:Name="PART_RowScrollViewer"
                                  CanContentScroll="False"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                      Background="Transparent">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="virtualListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,0.5" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{Binding Height}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        HorizontalAlignment="Stretch"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GridTimeRangeChart}" x:Key="defaultGridTimeRangeChartStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridTimeRangeChart}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--Corner-->
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0.5">
                            <ContentPresenter
                                x:Name="allHeader"
                                Content="{TemplateBinding CornerHeaderSource}"
                                ContentTemplate="{TemplateBinding CornerHeaderTemplate}"
                                ContentTemplateSelector="{TemplateBinding CornerHeaderTemplateSelector}" />
                        </Border>

                        <!--ColumnHeader-->
                        <Grid
                            Grid.Row="0"
                            Grid.Column="2"
                            >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                x:Name="PART_ColumnScrollViewer"
                                Grid.Column="0"
                                ScrollViewer.CanContentScroll="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled">
                                <local:ColumnHeaderRenderLayer Height="20"
                                  x:Name="PART_ColumnGrid"
                                  >
                                </local:ColumnHeaderRenderLayer >
                            </ScrollViewer>
                            <Border Grid.Column="1" x:Name="PART_ColumnRightSpacer" Background="Transparent" />
                        </Grid>

                        <!--RowHeader-->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox  x:Name="PART_RowHeaderListBox"
                                 Grid.Row="0"
                                 Style="{StaticResource virtualContainerListBoxStyle}"
                                 MinWidth="{TemplateBinding MinRowWidth}"
                                 BorderBrush="{TemplateBinding RuledLineFill}"
                                 BorderThickness="0,0,0,0.5"
                                 ItemContainerStyle="{StaticResource virtualListBoxItemStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"

                                 >
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding RawData}" 
                                        ContentTemplate="{Binding RowHeaderTemplate, RelativeSource={RelativeSource AncestorType=local:GridTimeRangeChart}}"
                                        ContentTemplateSelector="{Binding RowHeaderTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}}"

                                                      />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="1" x:Name="PART_RowBottomSpacer" Background="Transparent" />

                        </Grid>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

                        <!--Chart-->
                        <local:TimeRangeChart Grid.Row="1" Grid.Column="2"  x:Name="PART_Chart"
                                              StartTime="{TemplateBinding StartTime}"
                                              EndTime="{TemplateBinding EndTime}"
                                              MinSpan="{TemplateBinding MinSpan}"
                                              ChartHeight="{TemplateBinding ChartHeight}"
                                              WidthPerRuledLine="{TemplateBinding WidthPerRuledLine}"
                                              BackgroundTimes="{TemplateBinding BackgroundTimes}"
                                              Background="{TemplateBinding Background}"
                                              NonWorkingTimes="{TemplateBinding NonWorkingTimes}"
                                              NonWorkingRangeBackground="{TemplateBinding NonWorkingRangeBackground}"
                                              ScaleIncrement="{TemplateBinding ScaleIncrement}"
                                              SubScaleFormat="{TemplateBinding SubScaleFormat}"
                                              RuledLineFill="{TemplateBinding RuledLineFill}"
                                              RuledLineThickness="{TemplateBinding RuledLineThickness}"
                                              DataTemplate="{TemplateBinding ItemTemplate}"
                                              DataTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TimeUnit="{TemplateBinding TimeUnit}"
                                              MonthSpan="{TemplateBinding MonthSpan}"
                                              CanStackRange="{TemplateBinding CanStackRange}"
                                              HeaderFormat="{TemplateBinding HeaderFormat}"
                                              StackHeight="{TemplateBinding StackHeight}"
                                              HeaderBrushSelector="{TemplateBinding HeaderBrushSelector}"
                                              AllowMultiDrag="{TemplateBinding AllowMultiDrag}"
                                              AllowMultiSelection="{TemplateBinding AllowMultiSelection}"
                                              TimeRangeStyle="{Binding TimeRangeStyle, 
                                                 RelativeSource={RelativeSource TemplatedParent}, 
                                                 TargetNullValue={StaticResource timeRangeControlStyle}}"

                                              
                                                >

                        </local:TimeRangeChart>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
