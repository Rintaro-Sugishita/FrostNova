<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
    xmlns:cnv="clr-namespace:FrostNova.Core.Wpf.Converters;assembly=FrostNova.Core.Wpf"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wpfCommon="clr-namespace:FrostNova.Core.Wpf.Common;assembly=FrostNova.Core.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cnv:DateTimeFormatConverter x:Key="dateConverter" />
    <cnv:BorderThicknessConverter x:Key="borderThicknessConverter" />


    <Style x:Key="virtualContainerListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="false"
                      Padding="0"
                                  x:Name="PART_ScrollViewer"
                                  CanContentScroll="False"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                      Background="Transparent">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="virtualListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        HorizontalAlignment="Stretch"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="defaultGridTimeRangeChartStyle" TargetType="{x:Type local:GridTimeRangeChart}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridTimeRangeChart}">
                    <Grid>
                        <Grid.Resources>
                            <wpfCommon:BindingProxy x:Key="gridChartProxy" Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--  corner header  -->
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0.5">
                            <ContentPresenter
                                x:Name="allHeader"
                                Content="{TemplateBinding CornerHeaderSource}"
                                ContentTemplate="{TemplateBinding CornerHeaderTemplate}"
                                ContentTemplateSelector="{TemplateBinding CornerHeaderTemplateSelector}" />
                        </Border>


                        <!--  row header  -->
                        <ListBox
                                x:Name="rowHeaderListBox"
                                                            Grid.Row="1"
                            Grid.Column="0"

                                MinWidth="{TemplateBinding MinRowWidth}"
                                ItemTemplate="{TemplateBinding RowHeaderTemplate}"
                                ItemTemplateSelector="{TemplateBinding RowHeaderTemplateSelector}"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                Style="{StaticResource virtualContainerListBoxStyle}"
                                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <i:Interaction.Behaviors>
                                <behaviors:ItemsControlHeightSyncBehavior TargetItemsControl="{Binding ElementName=chartItemsControl}"
                                                                                DefaultMinHeight="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=RowHeight}"
                                                                              />
                            </i:Interaction.Behaviors>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource virtualListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>


                        <GridSplitter
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="4"
                            HorizontalAlignment="Stretch" />
                        <GridSplitter
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="4"
                            HorizontalAlignment="Stretch" />


                        <!--  column header  -->
                        <!--  datetimeアイテムを横に並べていく  -->
                        <ScrollViewer
                            x:Name="columnScrollViewer"
                            Grid.Row="0"
                            Grid.Column="2"
                            ScrollViewer.CanContentScroll="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                            <local:ColumnHeaderRenderLayer Grid.Row="0" Grid.Column="2"
                                  x:Name="PART_ColumnGrid"
                                  >
                            </local:ColumnHeaderRenderLayer>
                        </ScrollViewer>
                        <ListBox
                                x:Name="chartItemsControl"
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0"
                                Padding="0"
                                BorderThickness="0"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                ScrollViewer.CanContentScroll="False"
                                Style="{StaticResource virtualContainerListBoxStyle}"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                HorizontalAlignment="Left"
                                ScrollViewer.PanningMode="Both"
                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                >
                            <i:Interaction.Behaviors>
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="False"
                                    IsVerticalSync="True"
                                    SyncTarget="{Binding ElementName=rowHeaderListBox}" />
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="True"
                                    IsVerticalSync="False"
                                    SyncTarget="{Binding ElementName=columnScrollViewer}" />
                                <behaviors:ScrollGestureBehavior />
                            </i:Interaction.Behaviors>
                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <local:TimeRangeChart
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True"
                                            ChartHeight="{Binding Source={StaticResource gridChartProxy}, Path=Data.RowHeight}"
                                            AllowDrop="True"
                                            Background="{Binding Source={StaticResource gridChartProxy}, Path=Data.Background}"
                                            BorderBrush="Gray"
                                            CanDragTasksBetweenRows="{Binding Source={StaticResource gridChartProxy}, Path=Data.CanDragTasksBetweenRows}"
                                            EndTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.EndTime}"
                                            IsControlTick="False"
                                            MinSpan="{Binding Source={StaticResource gridChartProxy}, Path=Data.MinSpan}"
                                            NonWorkingRangeBackground="{Binding Source={StaticResource gridChartProxy}, Path=Data.NonWorkingRangeBackground}"
                                            ParentGridChart="{Binding Source={StaticResource gridChartProxy}, Path=Data, Mode=OneTime}"
                                            RuledLineFill="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineFill}"
                                            RuledLineThickness="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineThickness}"
                                            ScaleIncrement="{Binding Source={StaticResource gridChartProxy}, Path=Data.ScaleIncrement}"
                                            SelectedRanges="{Binding Source={StaticResource gridChartProxy}, Path=Data.SelectedRanges}"
                                            SelectedValues="{Binding Source={StaticResource gridChartProxy}, Path=Data.SelectedValues}"
                                            StartTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.StartTime}"
                                            Style="{Binding Source={StaticResource gridChartProxy}, Path=Data.ChartStyle}"
                                            TimeRangeStyle="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeRangeStyle, FallbackValue={StaticResource timeRangeControlStyle}}"
                                            TimeTicks="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeTicks}"
                                            SubTimeTicks="{Binding Source={StaticResource gridChartProxy}, Path=Data.SubTimeTicks}"
                                            TimeUnit="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeUnit}"
                                            WidthPerRuledLine="{Binding Source={StaticResource gridChartProxy}, Path=Data.WidthPerRuledLine}">
                                    </local:TimeRangeChart>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource virtualListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                    <Setter Property="MinHeight" Value="{Binding Source={StaticResource gridChartProxy}, Path=Data.RowHeight}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>


</ResourceDictionary>
