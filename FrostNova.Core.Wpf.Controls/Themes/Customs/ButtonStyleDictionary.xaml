<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    FrostNovaButtonStyle の定義元は Core.Wpf の共有辞書に一元化した。
    ここではそれを取り込み、派生スタイル(OK/Cancel)だけを定義する。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/FrostNova.Core.Wpf;component/Resources/ButtonStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="OkButtonStyle"
        BasedOn="{StaticResource ResourceKey=FrostNovaButtonStyle}"
        TargetType="Button">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="Green">
                            &#xF78C;
                        </TextBlock>
                        <TextBlock Margin="5,0,0,0">OK</TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="CancelButtonStyle"
        BasedOn="{StaticResource ResourceKey=FrostNovaButtonStyle}"
        TargetType="Button">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="#BB0000">
                            &#xF78A;
                        </TextBlock>
                        <TextBlock Margin="5,0,0,0">Cancel</TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>