<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="D:\tmp\nuget-packages" />
  </config>
  <packageSources>
    <!-- 優先順位を上にする -->
    <add key="Local" value="./.localNuget" />
