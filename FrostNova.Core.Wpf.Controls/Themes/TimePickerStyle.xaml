<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/Customs/ToggleButtonStyleDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ドラムの ▲/▼ ボタン。既定テンプレートに依存せず、ボタン全面を必ずヒット領域にする。
        Background=Transparent（ヒットテスト有効）の Border でセル全体を覆うため、
        右半分など一部が反応しない事象を防ぐ。
    -->
    <Style x:Key="TimePickerDrumRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="defaultFrostNovaTimePickerStyle" TargetType="{x:Type local:TimePicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimePicker}">
                    <Grid>
                        <ToggleButton x:Name="PART_BUTTON">
                            <ToggleButton.Style>
                                <Style BasedOn="{StaticResource FrostNovaToggleButtonStyle}" TargetType="{x:Type ToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_popup, Path=IsOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Segoe Fluent Icons">&#xe823;</TextBlock>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Popup x:Name="PART_popup"
                               Width="{TemplateBinding PopupWidth}"
                               Height="{TemplateBinding PopupHeight}"
                               MinWidth="{TemplateBinding MinPopupWidth}"
                               MinHeight="{TemplateBinding MinPopupHeight}"
                               MaxWidth="{TemplateBinding MaxPopupWidth}"
                               MaxHeight="{TemplateBinding MaxPopupHeight}"
                               IsOpen="{Binding IsChecked, ElementName=PART_BUTTON}"
                               Placement="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Placement, FallbackValue={x:Static PlacementMode.Bottom}}"
                               StaysOpen="True">
                            <Popup.Style>
                                <Style TargetType="{x:Type Popup}">
                                    <Setter Property="PlacementTarget" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" Value="{x:Null}">
                                            <Setter Property="PlacementTarget" Value="{Binding ElementName=PART_BUTTON}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>

                            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">

                                        <!-- Hour drum column -->
                                        <Grid Width="60">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <RepeatButton x:Name="PART_hour_up" Grid.Row="0" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe971;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                            <Grid Grid.Row="1" ClipToBounds="True" x:Name="PART_hour_container" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="PART_hour_r0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <TextBlock x:Name="PART_hour_r1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="PART_hour_r2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <Border Grid.Row="1" Height="32"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                        BorderThickness="0,1,0,1"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                            <RepeatButton x:Name="PART_hour_down" Grid.Row="2" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe972;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                        </Grid>

                                        <Border Width="1" Margin="0,8"
                                                Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>

                                        <!-- Minute drum column -->
                                        <Grid Width="60">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <RepeatButton x:Name="PART_minute_up" Grid.Row="0" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe971;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                            <Grid Grid.Row="1" ClipToBounds="True" x:Name="PART_minute_container" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="PART_minute_r0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <TextBlock x:Name="PART_minute_r1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="PART_minute_r2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <Border Grid.Row="1" Height="32"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                        BorderThickness="0,1,0,1"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                            <RepeatButton x:Name="PART_minute_down" Grid.Row="2" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe972;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                        </Grid>

                                        <!-- Second drum column (IsShowSecond=True のときのみ表示) -->
                                        <Border Width="1" Margin="0,8"
                                                Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsShowSecond}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Grid Width="60">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsShowSecond}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <RepeatButton x:Name="PART_second_up" Grid.Row="0" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe971;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                            <Grid Grid.Row="1" ClipToBounds="True" x:Name="PART_second_container" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                    <RowDefinition Height="32"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="PART_second_r0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <TextBlock x:Name="PART_second_r1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="PART_second_r2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.5" Cursor="Hand"/>
                                                <Border Grid.Row="1" Height="32"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                        BorderThickness="0,1,0,1"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                            <RepeatButton x:Name="PART_second_down" Grid.Row="2" Style="{StaticResource TimePickerDrumRepeatButtonStyle}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe972;" HorizontalAlignment="Center"/>
                                            </RepeatButton>
                                        </Grid>

                                    </StackPanel>

                                    <!-- 確定 / キャンセル -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                HorizontalAlignment="Center" Margin="4,4,4,4">
                                        <!--<Button x:Name="PART_cancel" Content="Cancel"
                                                MinWidth="64" Margin="0,0,4,0" Padding="8,4"/>-->
                                        <Button x:Name="PART_ok" Content="OK"
                                                MinWidth="64" Padding="8,4"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
