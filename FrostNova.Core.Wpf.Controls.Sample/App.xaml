    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls.Sample"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="ConverterDictionary.xaml" />-->
