<Window x:Class="FrostNova.TimeRangeChart.Wpf.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf.Sample"
        xmlns:chart="clr-namespace:FrostNova.TimeRangeChart.Wpf;assembly=FrostNova.TimeRangeChart.Wpf"
        mc:Ignorable="d"
        Name="mainWindow"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeChartStyle.xaml"/>
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml"/>
                    <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/GridTimeRangeChartStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <sys:TimeSpan x:Key="minSpan">1.0:0:0</sys:TimeSpan>



                <Style TargetType="chart:TimeRangeControl" x:Key="rangeStyle" BasedOn="{StaticResource timeRangeControlStyle}">
                    <Setter Property="StartTime" Value="{Binding StartTime}" />
                    <Setter Property="EndTime" Value="{Binding EndTime}" />
                    <Setter Property="WorkingSpan" Value="{Binding WorkingSpan}" />
                    <Setter Property="ActualSpan" Value="{Binding ActualSpan}" />
                    <Setter Property="IsMilestone" Value="False" />
                    <Setter Property="CanDrag" Value="True" />
                    <Setter Property="CanExpandSpan" Value="True" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{Binding Color}"></SolidColorBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate DataType="{x:Type local:SampleModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartTime, StringFormat=MM/dd}" />
                                    <TextBlock Text="("/>
                                    <TextBlock Text="{Binding ActualSpan.Days}" />
                                    <TextBlock Text=")"/>
                                    <TextBlock Text="{Binding WorkingSpan.Days}" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>


                </Style>



            </ResourceDictionary>
        </Grid.Resources>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{StaticResource PageUris}" Name="pageList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

        <Frame Grid.Column="2" Source="{Binding ElementName=pageList, Path=SelectedItem.PageUri}"
               NavigationUIVisibility="Hidden"
               
               >
            
        </Frame>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SetDataCommand}" Content="データセット" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="grid">

                <chart:GridTimeRangeChart StartTime="{Binding GridVm.ChartStart}" EndTime="{Binding GridVm.ChartEnd}" WidthPerRuledLine="100"
                                          MinSpan="{StaticResource minSpan}" ScaleIncrement="{StaticResource minSpan}"
                                          ItemsSource="{Binding GridVm.ModelList}"
                                          MinRowWidth="200"
                                          HeaderFormat="yyyy/MM/dd"
                                          RuledLineThickness="0.5"
                                          RuledLineFill="Gray"
                                          RowHeight="150"
                                          CanDragTasksBetweenRows="True"
                                          TimeRangeStyle="{StaticResource rangeStyle}"
                                          NonWorkingRangeBackground="#f0f0f0"
                                          >
                    <chart:GridTimeRangeChart.CornerHeaderSource>
                        <TextBlock Text="aaaa" />
                    </chart:GridTimeRangeChart.CornerHeaderSource>
                    <chart:GridTimeRangeChart.RowHeaderTemplate>
                        <DataTemplate DataType="{x:Type local:GridSampleData}">
                            <TextBlock Text="{Binding Name}" Height="150" />
                        </DataTemplate>
                    </chart:GridTimeRangeChart.RowHeaderTemplate>
                    <chart:GridTimeRangeChart.ChartStyle>
                        <Style TargetType="{x:Type chart:TimeRangeChart}" >
                            <Setter Property="ItemsSource" Value="{Binding Tasks}" />
                            <Setter Property="NonWorkingTimes" Value="{Binding ElementName=mainWindow, Path=DataContext.GridVm.NonWorkingTimes}" />
                        </Style>
                    </chart:GridTimeRangeChart.ChartStyle>

                </chart:GridTimeRangeChart>
            </TabItem>
            <TabItem Header="month grid">

                <chart:GridTimeRangeChart StartTime="{Binding MonthGridVm.ChartStart}" EndTime="{Binding MonthGridVm.ChartEnd}" WidthPerRuledLine="200"
                                          MinSpan="{StaticResource minSpan}" ScaleIncrement="{StaticResource minSpan}"
                                          TimeUnit="Month" MonthSpan="2"
                                          ItemsSource="{Binding MonthGridVm.ModelList}"
                                          MinRowWidth="200"
                                          HeaderFormat="yyyy/MM"
                                          RuledLineThickness="0.5"
                                          RuledLineFill="Gray"
                                          NonWorkingRangeBackground="#e0e0e0"
                                          RowHeight="150"
                                          TimeRangeStyle="{StaticResource rangeStyle}"
                                          >
                    <chart:GridTimeRangeChart.CornerHeaderSource>
                        <TextBlock Text="aaaa" />
                    </chart:GridTimeRangeChart.CornerHeaderSource>
                    <chart:GridTimeRangeChart.RowHeaderTemplate>
                        <DataTemplate DataType="{x:Type local:GridSampleData}">
                            <TextBlock Text="{Binding Name}" Height="150" />
                        </DataTemplate>
                    </chart:GridTimeRangeChart.RowHeaderTemplate>
                    <chart:GridTimeRangeChart.ChartStyle>
                        <Style TargetType="{x:Type chart:TimeRangeChart}" >
                            <Setter Property="ItemsSource" Value="{Binding Tasks}" />
                            <Setter Property="NonWorkingTimes" Value="{Binding ElementName=mainWindow, Path=DataContext.MonthGridVm.NonWorkingTimes}" />
                        </Style>
                    </chart:GridTimeRangeChart.ChartStyle>

                </chart:GridTimeRangeChart>
            </TabItem>
            <TabItem Header="chart">
                <chart:TimeRangeChart StartTime="{Binding ChartVm.ChartStart}" EndTime="{Binding ChartVm.ChartEnd}"
                                  MinSpan="{StaticResource minSpan}" ScaleIncrement="{StaticResource minSpan}"
                                  ItemsSource="{Binding ChartVm.Model.Tasks}"
                                  RuledLineThickness="0.5"
                                  RuledLineFill="Gray"
                                      NonWorkingTimes="{Binding ChartVm.NonWorkingTimes}"
                                      >
                    <chart:TimeRangeChart.TimeRangeStyle>
                        <Style TargetType="{x:Type chart:TimeRangeControl}" BasedOn="{StaticResource {x:Type chart:TimeRangeControl}}">
                            <Setter Property="Background" >
                                <Setter.Value>
                                    <SolidColorBrush Color="{Binding Color}"></SolidColorBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Height" Value="60" />
                            <Setter Property="StartTime" Value="{Binding StartTime}"/>
                            <Setter Property="EndTime" Value="{Binding EndTime}"/>
                            <Setter Property="WorkingSpan" Value="{Binding WorkingSpan}"/>
                            <Setter Property="CanExpandSpan" Value="True" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,30,0,10" />
                            <Setter Property="IsMilestone" Value="True" />
                            <Setter Property="Width" Value="20" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="MilestoneType" Value="Circle" />

                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate DataType="{x:Type local:SampleModel}">
                                        <TextBlock Text="{Binding WorkingSpan}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StartTime}" />
                                        </StackPanel>
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </chart:TimeRangeChart.TimeRangeStyle>
                </chart:TimeRangeChart>

            </TabItem>
        </TabControl>


    </Grid>
</Window>
