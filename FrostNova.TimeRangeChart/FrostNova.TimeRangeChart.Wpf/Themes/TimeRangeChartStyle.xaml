<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:bProxy="clr-namespace:FrostNova.Core.Wpf.Common;assembly=FrostNova.Core.Wpf"
                    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
                    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
                    >
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
        </ResourceDictionary.MergedDictionaries>



    <Style TargetType="{x:Type local:TimeRangeChart}" x:Key="defaultTimeRangeChartStyle">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeRangeChart}">
                    <!--<Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">-->
                        
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <bProxy:BindingProxy Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" x:Key="bindingProxy"/>
                        </Grid.Resources>

                        <ItemsControl x:Name="nonWorkingGanttCanvas" ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=SortedNonWorkingTimes}"                      
                                        >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:TimeRangeControl 
                                                            ParentChart="{Binding Source={StaticResource bindingProxy},Path=Data,Mode=OneTime}"
                                                            Height="{Binding Source={StaticResource bindingProxy}, Path=Data.ActualHeight}"
                                                            StartTime="{Binding StartTime}"
                                                            EndTime="{Binding EndTime}"
                                                            WorkingSpan="{Binding WorkingSpan}"
                                                            IgnoreNonWorkingTimes="True"
                                                            Style="{StaticResource nonWorkingTimeRangeStyle}"
                                                            >
                                        <i:Interaction.Behaviors>
                                            <behaviors:CanvasHelperBehavior BindLeft="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}} , Path=Left}"
                                                        />
                                        </i:Interaction.Behaviors>
                                    </local:TimeRangeControl>
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>
                        </ItemsControl>



                        <ItemsControl x:Name="borderCanvas" ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=TimeTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Height="{Binding ActualHeight}" 
                                               Width="{Binding RuledLineThickness}"
                                               Fill="{Binding RuledLineFill}"
                                                />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftPoint}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>


                        <ItemsControl x:Name="ganttCanvas" ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ItemsSource}"   
                                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                      AllowDrop="{TemplateBinding AllowDrop}"
                                      >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas AllowDrop="{TemplateBinding AllowDrop}" Background="Transparent" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:TimeRangeControl
                                            ParentChart="{Binding Source={StaticResource bindingProxy},Path=Data,Mode=OneTime}"
                                            Style="{Binding Source={StaticResource bindingProxy},Path=Data.TimeRangeStyle, FallbackValue={StaticResource timeRangeControlStyle}}"
                                            >
                                        <i:Interaction.Behaviors>
                                            <behaviors:CanvasHelperBehavior BindLeft="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}} , Path=Left}"
                                                                            CanvasVerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=VerticalAlignment}"
                                                        />
                                            <!--<behaviors:DragSourceBehavior DragData="{Binding RelativeSource={RelativeSource Self}}"
                                                                          SourceParameter="{Binding Source={StaticResource bindingProxy},Path=Data.ItemsSource,Mode=OneTime}"
                                                                          />-->
                                        </i:Interaction.Behaviors>
                                    </local:TimeRangeControl>
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <!--</Border>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>