<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls"
                    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/ColorPaletteStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/ColorSelectorStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf;component/Resources/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ColorPicker}" x:Key="defaultColorPickerStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPicker}">
                    <Grid>
                        <ToggleButton x:Name="PART_BUTTON"
                                      Background="{TemplateBinding SelectedColor, Converter={StaticResource colorToSolidBrushConverter},ConverterParameter=Colors.White}"
                                                           Foreground="{TemplateBinding SelectedColor, Converter={StaticResource foregroundConverter}}"
                                      >
                            <!--<ToggleButton.Background>
                                <SolidColorBrush Color="{TemplateBinding SelectedColor}" />
                            </ToggleButton.Background>-->
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_popup, Path=IsOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Segoe Fluent Icons"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}},Path=Foreground}"
                                                           >&#xe790;</TextBlock>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <!--<Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{TemplateBinding SelectedColor}" />
                                        </Setter.Value>

                                    </Setter>-->
                                    <!--<Setter Property="Background" Value="{TemplateBinding SelectedColor, Converter={StaticResource colorToBrushConverter},ConverterParameter=Colors.White}"/>-->
                                </Style>
                            </ToggleButton.Style>

                        </ToggleButton>
                        <Popup x:Name="PART_popup"
                               IsOpen="{Binding IsChecked, ElementName=PART_BUTTON}" StaysOpen="True" 
                               MaxHeight="{TemplateBinding MaxPopupHeight}"
                               MinHeight="{TemplateBinding MinPopupHeight}"
                               Height="{TemplateBinding PopupHeight}"
                               MaxWidth="{TemplateBinding MaxPopupWidth}"
                               MinWidth="{TemplateBinding MinPopupWidth}"
                               Width="{TemplateBinding PopupWidth}"
                               Placement="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Placement,FallbackValue={x:Static PlacementMode.Bottom}}"                             
                               >
                            <Popup.Style>
                                <Style TargetType="{x:Type Popup}">
                                    <Setter Property="PlacementTarget" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" />
                                    
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" Value="{x:Null}">
                                            <Setter Property="PlacementTarget" Value="{Binding ElementName=PART_BUTTON}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <local:ColorPalette Height="80" SelectedColor="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CurrentPopupColor,Mode=TwoWay}" />
                                <local:ColorSelector Grid.Row="1" x:Name="colorSelecter" 
                                                     SelectedColor="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CurrentPopupColor, Mode=TwoWay}" 
                                                     OldColor="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OldPopupColor, Mode=TwoWay}"  >
                                </local:ColorSelector>
                                <Grid Grid.Row="2" 
                    Background="white">
                                    <Button x:Name="PART_OK" Width="60" Content="OK"  />
                                </Grid>



                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>