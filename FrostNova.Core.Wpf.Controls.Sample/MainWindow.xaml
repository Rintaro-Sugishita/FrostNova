<Window
    x:Class="FrostNova.Core.Wpf.Controls.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:att="clr-namespace:FrostNova.Core.Wpf.AttachedProperties;assembly=FrostNova.Core.Wpf"
    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
    xmlns:conv="clr-namespace:FrostNova.Core.Wpf.Controls.Converters;assembly=FrostNova.Core.Wpf.Controls"
    xmlns:ctrls="clr-namespace:FrostNova.Core.Wpf.Controls;assembly=FrostNova.Core.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls.Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <sys:TimeSpan x:Key="timeOne">01:30:00</sys:TimeSpan>
        <sys:TimeSpan x:Key="minValueSource">00:00:00</sys:TimeSpan>
        <sys:TimeSpan x:Key="maxValueSource">24:00:00</sys:TimeSpan>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Time">
                <StackPanel>
                    <TextBox Text="{Binding Date}" />
                    <ctrls:TimePicker IsPartsDateTime="True" TimeValue="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Text="{Binding Span}" />
                    <ctrls:TimePicker
                        IsPartsDateTime="False"
                        IsShowSecond="True"
                        TimeValue="{Binding Span, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ctrls:FontComboBox />
                </StackPanel>
            </TabItem>

            <TabItem Header="TimePickerEditBox" IsSelected="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ctrls:TimePickerEditBox MinHeight="20" Height="30"
                                             HorizontalContentAlignment="Right"
                                             TimeValue="{StaticResource timeOne}"
                                             IsShowSecond="{Binding ElementName=secondCheckBox,Path=IsChecked}"
                                             IsShowDay="{Binding ElementName=dayCheckBox,Path=IsChecked}"
                                             TimePickerButtonVisibility="{Binding ElementName=pickerCheckBox,Path=IsChecked,Converter={StaticResource boolToVisibilityConverter}}"
                                             UpDownButtonVisibility="{Binding ElementName=updownCheckBox,Path=IsChecked,Converter={StaticResource boolToVisibilityConverter}}"
                                             MinuteSpan="{Binding ElementName=minuteSpanTextbox,Path=Text}"
                                             VerticalContentAlignment="Center"
                                             >
                        <ctrls:TimePickerEditBox.Style>
                            <Style TargetType="{x:Type ctrls:TimePickerEditBox}" BasedOn="{StaticResource {x:Type ctrls:TimePickerEditBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=minLimitCheckBox, Path=IsChecked}" Value="True">
                                        <Setter Property="MinValue" Value="{StaticResource minValueSource}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=minLimitCheckBox, Path=IsChecked}" Value="Fals">
                                        <Setter Property="MinValue" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=maxLimitCheckBox, Path=IsChecked}" Value="True">
                                        <Setter Property="MaxValue" Value="{StaticResource maxValueSource}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=maxLimitCheckBox, Path=IsChecked}" Value="Fals">
                                        <Setter Property="MaxValue" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrls:TimePickerEditBox.Style>
                    </ctrls:TimePickerEditBox>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="secondCheckBox" Content="Show Second" />
                        <CheckBox x:Name="dayCheckBox" Content="Show Day" />
                        <CheckBox x:Name="pickerCheckBox" Content="Visible Picker" />
                        <CheckBox x:Name="updownCheckBox" Content="Visible UpDown" IsChecked="True" />
                        <CheckBox x:Name="minLimitCheckBox" Content="Limit min value to Zero" />
                        <CheckBox x:Name="maxLimitCheckBox" Content="Limit max value to 23:59" />
                        <TextBox x:Name="minuteSpanTextbox" Text="10" />
                    </StackPanel>
                </Grid>



            </TabItem>
            
            <TabItem Header="Color">
                <StackPanel>
                    <ctrls:ColorSelector />
                    <Button Command="{Binding ShowColorDialogCommand}" Content="select" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            MinWidth="200"
                            HorizontalAlignment="Stretch"
                            Text="{Binding SelectedColor, Converter={StaticResource colorTextConverter}, Mode=TwoWay}" />
                        <ctrls:ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox MinWidth="200" HorizontalAlignment="Stretch" />
                        <ctrls:ColorPicker IsDialogMode="True" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="DataGrid1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <DataGrid
                        att:DataGridEx.SelectedItems="{Binding SelectedSamples}"
                        att:DataGridEx.SelectedItemsChangeCommand="{Binding SelectedItemsChangedCommand}"
                        ItemsSource="{Binding Samples}">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridRowNumberDisplayBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ColumnValue}" Header="Column1" />
                            <DataGridTextColumn Binding="{Binding NumValue}" Header="Column2">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type TextBox}">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <ctrls:FrostNovaDataGridTextBoxColumn
                                Binding="{Binding MultiLineText}"
                                CanLineBreak="True"
                                Header="custom1"
                                IsEditOnEnter="False" />
                        </DataGrid.Columns>


                    </DataGrid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding SelectedIndices}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" />
                                        <TextBlock Text="index row is selected." />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1">
                            <CheckBox x:Name="lineBreakCheckbox" Content="CanLineBreak" />
                            <CheckBox x:Name="alwaysEditCheckbox" Content="AlwaysEdit" />
                        </StackPanel>

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="messagebox">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                            <Setter Property="Height" Value="40" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding ShowErrorMessageCommand}" Content="show error" />
                    <Button Command="{Binding ShowMultiLineMessageCommand}" Content="show error" />
                    <Button Command="{Binding ShowWarningMessageCommand}" Content="show error" />
                </StackPanel>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
