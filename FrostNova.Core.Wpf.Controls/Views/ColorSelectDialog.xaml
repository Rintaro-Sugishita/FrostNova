<Window x:Class="FrostNova.Core.Wpf.Controls.Views.ColorSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls"
        xmlns:vm="clr-namespace:FrostNova.Core.Wpf.Controls.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type vm:ColorSelectDialogViewModel},IsDesignTimeCreatable=True}"
        Title="ColorSelectDialog" Height="340" Width="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <local:ColorPalette Height="80" SelectedColor="{Binding SelectedColor,Mode=TwoWay}" />
        <local:ColorSelector Grid.Row="1" x:Name="colorSelecter" SelectedColor="{Binding SelectedColor, Mode=TwoWay}" OldColor="{Binding OldColor}" >
        </local:ColorSelector>
        <Grid Grid.Row="2" 
                    Background="white">
            <Button x:Name="okButton" Width="60" Content="OK" Margin="50,0,10,0" HorizontalAlignment="Left" Command="{Binding CloseCommand}"  />
            <Button x:Name="cancelButton" Width="60" Content="Cancel" Margin="10,0,50,0" HorizontalAlignment="Right" Command="{Binding CloseCancelCommand}" />
        </Grid>


    </Grid>
</Window>
