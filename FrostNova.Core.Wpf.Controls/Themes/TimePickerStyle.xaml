<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/Customs/ToggleButtonStyleDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="defaultFrostNovaTimePickerStyle" TargetType="{x:Type local:TimePicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimePicker}">
                    <Grid>
                        <ToggleButton x:Name="PART_BUTTON">
                            <ToggleButton.Style>
                                <Style BasedOn="{StaticResource FrostNovaToggleButtonStyle}" TargetType="{x:Type ToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_popup, Path=IsOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Segoe Fluent Icons">&#xe823;</TextBlock>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>

                        </ToggleButton>
                        <Popup
                            x:Name="PART_popup"
                            Width="{TemplateBinding PopupWidth}"
                            Height="{TemplateBinding PopupHeight}"
                            MinWidth="{TemplateBinding MinPopupWidth}"
                            MinHeight="{TemplateBinding MinPopupHeight}"
                            MaxWidth="{TemplateBinding MaxPopupWidth}"
                            MaxHeight="{TemplateBinding MaxPopupHeight}"
                            IsOpen="{Binding IsChecked, ElementName=PART_BUTTON}"
                            Placement="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Placement, FallbackValue={x:Static PlacementMode.Bottom}}"
                            StaysOpen="False">
                            <Popup.Style>
                                <Style TargetType="{x:Type Popup}">
                                    <Setter Property="PlacementTarget" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlacementTarget}" Value="{x:Null}">
                                            <Setter Property="PlacementTarget" Value="{Binding ElementName=PART_BUTTON}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ListBox
                                    x:Name="PART_hour"
                                    ItemsSource="{TemplateBinding Hours}"
                                    SelectedItem="{Binding HourValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    SelectionMode="Single" />
                                <ListBox
                                    x:Name="PART_minute"
                                    Grid.Column="1"
                                    ItemsSource="{TemplateBinding Minutes}"
                                    SelectedItem="{Binding MinuteValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    SelectionMode="Single" />
                                <ListBox
                                    x:Name="PART_second"
                                    Grid.Column="2"
                                    ItemsSource="{TemplateBinding Seconds}"
                                    SelectedItem="{Binding SecondValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListBox.Style>
                                        <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type ListBox}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsShowSecond}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                </ListBox>


                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>