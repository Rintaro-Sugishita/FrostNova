<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Company></Company>
    <PackageOutputPath>$(SolutionDir).localNuget</PackageOutputPath>

    <Authors>R.Sugishita</Authors>
    <RepositoryUrl>https://github.com/Rintaro-Sugishita/FrostNova</RepositoryUrl>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!--<ArtifactsPath>$(SolutionDir)\.artifacts</ArtifactsPath> -->
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>

    <EmitEmbeddedSources>true</EmitEmbeddedSources>
    <DebugType>embedded</DebugType>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <NupkgCopyDestination>$(SolutionDir)\.LocalNuget</NupkgCopyDestination>
  </PropertyGroup>

  <!-- Visual Studioバージョンを固定する -->
  <Target Name="EnforceVisualStudioVersion" BeforeTargets="Build">
    <PropertyGroup>
      <MinimumMSBuildVersion>18.0</MinimumMSBuildVersion>
    </PropertyGroup>    
    <Error Condition="'$(MSBuildVersion)' &lt; '$(MinimumMSBuildVersion)'" 
           Text="This project requires Visual Studio 2026 or a newer version (MSBuild $(MinimumMSBuildVersion) or higher). Current MSBuild version is $(MSBuildVersion). Please update your IDE or build tools." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' != 'Release' AND '$(Version)' != ''">
    <Now>$([System.DateTime]::Now.ToString("yyyyMMddHHmm"))</Now>
    <VersionPrefix>$(Version)-dev</VersionPrefix>
    <VersionSuffix>$(Now)</VersionSuffix>
  </PropertyGroup>
    
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

    <Target Name="CopyNupkgAfterEachPack"
            AfterTargets="Pack"
            DependsOnTargets="Pack"
            Condition="Exists('$(OutputPath)')">
      <ItemGroup>
        <BuiltNupkgFiles Include="$(OutputPath)\$(PackageId).$(PackageVersion).nupkg" />
      </ItemGroup>

      <!-- <MakeDir Directories="$(NupkgCopyDestination)" />

      <Copy
        SourceFiles="@(BuiltNupkgFiles)"
        DestinationFolder="$(NupkgCopyDestination)"
        SkipUnchangedFiles="true"
        Condition="@(BuiltNupkgFiles) != ''" /> -->
  </Target>
  <ItemGroup>
    <PackageVersion Include="FrostNova.Core" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Wpf" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Wpf.Controls" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Registry" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.ExcelWork" Version="0.0.8" />
    <PackageVersion Include="FrostNova.TimeRangeChart" Version="0.0.8" />
    <PackageVersion Include="FrostNova.TimeRangeChart.Wpf" Version="0.0.8" />
    <PackageVersion Include="FrostNova.WindowEventPickers" Version="0.0.8" />
  </ItemGroup>


</Project>
