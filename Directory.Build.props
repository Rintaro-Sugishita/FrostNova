<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Company></Company>
    <PackageOutputPath>$(SolutionDir).localNuget</PackageOutputPath>

    <Authors>R.Sugishita</Authors>
    <RepositoryUrl>https://github.com/Rintaro-Sugishita/FrostNova</RepositoryUrl>

   <EmitEmbeddedSources>true</EmitEmbeddedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Version>0.0.3.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <Now>$([System.DateTime]::Now.ToString("yyyyMMddHHmm"))</Now>
    <VersionPrefix>0.0.3-dev</VersionPrefix>
    <VersionSuffix>$(Now)</VersionSuffix>

  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="FrostNova.Core.Wpf" Version="0.0.3" />
    <PackageVersion Include="FrostNova.Core" Version="0.0.3" />
    <PackageVersion Include="FrostNova.Core.Registry" Version="0.0.3" />
    <PackageVersion Include="FrostNova.TimeRangeChart" Version="0.0.3" />
    <PackageVersion Include="FrostNova.TimeRangeChart.Wpf" Version="0.0.3" />
    <PackageVersion Include="FrostNova.Core.Wpf.Controls" Version="0.0.3" />
    <PackageVersion Include="FrostNova.Core.ExcelWork" Version="0.0.3" />
    <PackageVersion Include="FrostNova.WindowEventPickers" Version="0.0.3" />

  </ItemGroup>


</Project>
