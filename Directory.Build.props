<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Company></Company>
    <PackageOutputPath>$(SolutionDir).localNuget</PackageOutputPath>
    
    <Authors>R.Sugishita</Authors>
    <RepositoryUrl>https://github.com/Rintaro-Sugishita/FrostNova</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Version>0.0.1.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <Now>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</Now>
    <VersionPrefix>0.0.2-dev</VersionPrefix>
    <VersionSuffix>$(Now)</VersionSuffix>

  </PropertyGroup>

<ItemGroup>
  <PackageVersion Include="FrostNova.Core.Wpf" Version="0.0.1" />
  <PackageVersion Include="FrostNova.Core" Version="0.0.1" />
  <PackageVersion Include="FrostNova.Core.Registry" Version="0.0.1" />
  <PackageVersion Include="FrostNova.TimeRangeChart" Version="0.0.1" />
  <PackageVersion Include="FrostNova.TimeRangeChart.Wpf" Version="0.0.1" />

</ItemGroup>


</Project>
