<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:cnv="clr-namespace:FrostNova.Core.Wpf.Converters;assembly=FrostNova.Core.Wpf"
                    xmlns:timeRangeBase="clr-namespace:FrostNova.TimeRangeChart;assembly=FrostNova.TimeRangeChart"
                    xmlns:timeRangeHelpers="clr-namespace:FrostNova.TimeRangeChart.TimeRangeHelpers;assembly=FrostNova.TimeRangeChart"
                    xmlns:localConv="clr-namespace:FrostNova.TimeRangeChart.Wpf.Converters"
                    >



    <localConv:MilestonePositionConverter x:Key="MilestonePositionConverter" />
    <localConv:RangeContentPaddingConverter x:Key="RangeContentPaddingConverter" />
    <cnv:BorderThicknessConverter x:Key="borderThicknessConverter" />

    <sys:Double x:Key="expandWidth">7</sys:Double>


    <Style TargetType="{x:Type Thumb}" x:Key="expandThumbStyle">
        <Setter Property="Width" Value="{StaticResource expandWidth}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="1,3">
                        <Border Background="White" CornerRadius="4" >
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=IsExpandThumbAnyTimeVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsSelected}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Thumb}" x:Key="moveThumbStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" HorizontalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value=" 0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=CanDrag}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="rangeBorder">
        <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=BorderBrush}" />
        <Setter Property="BorderThickness" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=BorderThickness}" />
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=TaskWidth}" />
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=Height}" />
        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=Background}" />
        <Setter Property="Focusable" Value="True" />

        <Setter Property="Padding">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource RangeContentPaddingConverter}" Mode="OneWay">
                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimeRangeControl}}" Path="BorderThickness" />
                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimeRangeControl}}" Path="SelectedBorderThickness" />
                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimeRangeControl}}" Path="IsSelected" />
                </MultiBinding>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=SelectedBorderBrush}" />
                <Setter Property="BorderThickness" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}, Path=SelectedBorderThickness}" />
            </DataTrigger>
        </Style.Triggers>


    </Style>

    <DataTemplate x:Key="diamondMilestoneTemplate">
        <Polygon x:Name="diamondMilestone" Points="10,0 20,10 10,20 0,10"
                                                    Width="{TemplateBinding Width}" 
                                                    Height="{TemplateBinding Height}"
                                                    Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Background}"
                                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=BorderBrush}"
                                                     >
        </Polygon>
    </DataTemplate>

    <DataTemplate x:Key="circleMilestoneTemplate">
        <Ellipse x:Name="circleMilestone"
                Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Width}" 
                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Height}"
                Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Background}"
                Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=BorderBrush}"
                    >
        </Ellipse>

    </DataTemplate>


    <Style TargetType="{x:Type local:TimeRangeControl}" x:Key="timeRangeControlStyle"
           >
        <Setter Property="Background" Value="Aqua" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Canvas.Left" Value="{Binding Left, RelativeSource={RelativeSource Self}}" />
        <!--<Setter Property="Canvas.Top" Value="{Binding Top, RelativeSource={RelativeSource Self}}" />-->
        <Setter Property="Focusable" Value="True" />
        <!--<Setter Property="MinSpan" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeChart}},Path=MinSpan}" />-->



        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                    <Canvas Width="{TemplateBinding TaskWidth}">
                        <Border Style="{StaticResource rangeBorder}"
                                Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                                >
                            <Grid>
                                <ContentPresenter ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ContentTemplate}"
                                                   Content="{Binding}" 
                                                   Focusable="True"                
                                                  >
                                    <ContentPresenter.Margin>
                                        <MultiBinding  Converter="{StaticResource borderThicknessConverter}">
                                            <Binding Source="{StaticResource expandWidth}"  />
                                            <Binding  Mode="OneTime">
                                                <Binding.Source>
                                                    <sys:Double>0</sys:Double>
                                                </Binding.Source>
                                            </Binding>
                                            <Binding Source="{StaticResource expandWidth}" />
                                            <Binding  Mode="OneTime">
                                                <Binding.Source>
                                                    <sys:Double>0</sys:Double>
                                                </Binding.Source>
                                            </Binding>
                                        </MultiBinding>

                                    </ContentPresenter.Margin>

                                </ContentPresenter>

                                <Thumb Name="PART_MoveThumb"   Grid.Column="1"
                                       Background="Transparent"
                                       HorizontalAlignment="Stretch"
                                           Style="{StaticResource moveThumbStyle}"
                                       >
                                </Thumb>
                            </Grid>

                        </Border>

                        <Thumb Name="PART_LeftThumb" Height="{TemplateBinding Height}"  Canvas.Left="0"  Grid.Column="0"
                               Background="{TemplateBinding Background}"
                               Style="{StaticResource expandThumbStyle}"
                               Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                               >
                        </Thumb>
                        <Thumb Name="PART_RightThumb" Height="{TemplateBinding Height}" Canvas.Right="0" Grid.Column="2"
                               Background="{TemplateBinding Background}"
                               Style="{StaticResource expandThumbStyle}"
                               Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                               >
                        </Thumb>

                    </Canvas>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMilestone" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                            <!--<Canvas Width="{TemplateBinding Width}">
                                <Border Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Grid.Column="1" 
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}" 
                                >-->

                            <Grid  Width="{TemplateBinding Width}" ClipToBounds="False"
                                Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"

                                      >
                                <Grid.RenderTransform>
                                    <TranslateTransform
                                                X="{Binding RelativeSource={RelativeSource AncestorType={x:Type Grid}}, 
                                                    Path=Width, 
                                                    Converter={StaticResource MilestonePositionConverter}}" />
                                </Grid.RenderTransform>

                                <StackPanel Orientation="Horizontal">

                                    <ContentControl>
                                        <ContentControl.Style>
                                            <Style TargetType="{x:Type ContentControl}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=MilestoneType}" Value="{x:Static timeRangeBase:MilestoneStyle.Diamond}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource diamondMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=MilestoneType}" Value="{x:Static timeRangeBase:MilestoneStyle.Circle}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource circleMilestoneTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>

                                    </ContentControl>

                                    <ContentPresenter  ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ContentTemplate}"
                                                       Content="{Binding}"
                                                       Height="{TemplateBinding Height}"
                                                       ClipToBounds="False"
                                                   />
                                </StackPanel>

                                <Thumb Name="PART_MoveThumb"  
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                       ToolTip="{TemplateBinding ToolTip}"
                                        >


                                    <Thumb.Style>
                                        <Style TargetType="{x:Type Thumb}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="Transparent"
                                                            HorizontalAlignment="Stretch"
                                                            />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderThickness" Value=" 0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <!--<Setter Property="HorizontalAlignment" Value="Stretch" />-->
                                            <Setter Property="VerticalAlignment" Value="Stretch" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=CanDrag}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Thumb.Style>

                                </Thumb>
                            </Grid>
                            <!--</Border>
                            </Canvas>-->
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMilestone" Value="False" />
                    <Condition Property="CanDrag" Value="False" />
                    <Condition Property="CanExpandSpan" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                            <Canvas Width="{TemplateBinding TaskWidth}">
                                <Border Style="{StaticResource rangeBorder}"
                                        Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"

                                        >
                                    <Grid>
                                        <ContentPresenter ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ContentTemplate}"
                                                   Content="{Binding}" 
                                                          >
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMilestone" Value="False" />
                    <Condition Property="CanDrag" Value="True" />
                    <Condition Property="CanExpandSpan" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                            <Canvas Width="{TemplateBinding TaskWidth}">
                                <Border Style="{StaticResource rangeBorder}"
                                        Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                                        >
                                    <Grid>
                                        <ContentPresenter ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ContentTemplate}"
                                                   Content="{Binding}" 
                                                          >
                                        </ContentPresenter>
                                        <Thumb Name="PART_MoveThumb"   Grid.Column="1"
                                               Background="Transparent"
                                               HorizontalAlignment="Stretch"
                                                   Style="{StaticResource moveThumbStyle}"
                                               >
                                        </Thumb>

                                    </Grid>
                                </Border>
                            </Canvas>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMilestone" Value="False" />
                    <Condition Property="CanDrag" Value="False" />
                    <Condition Property="CanExpandSpan" Value="True" />
                    <Condition Property="IsFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                            <Canvas Width="{TemplateBinding TaskWidth}">
                                <Border Style="{StaticResource rangeBorder}"
                                        Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"                                
                                        >
                                    <Grid>
                                        <ContentPresenter ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ContentTemplate}"
                                                   Content="{Binding}" 
                                                          >
                                            <ContentPresenter.Margin>
                                                <MultiBinding  Converter="{StaticResource borderThicknessConverter}">
                                                    <Binding Source="{StaticResource expandWidth}"  />
                                                    <Binding  Mode="OneTime">
                                                        <Binding.Source>
                                                            <sys:Double>0</sys:Double>
                                                        </Binding.Source>
                                                    </Binding>
                                                    <Binding Source="{StaticResource expandWidth}" />
                                                    <Binding  Mode="OneTime">
                                                        <Binding.Source>
                                                            <sys:Double>0</sys:Double>
                                                        </Binding.Source>
                                                    </Binding>
                                                </MultiBinding>

                                            </ContentPresenter.Margin>
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                                <Thumb Name="PART_LeftThumb" Height="{TemplateBinding Height}"  Canvas.Left="0"  Grid.Column="0"
                               Background="{TemplateBinding Background}"
                               Style="{StaticResource expandThumbStyle}"
                                Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                               >
                                </Thumb>
                                <Thumb Name="PART_RightThumb" Height="{TemplateBinding Height}" Canvas.Right="0" Grid.Column="2"
                               Background="{TemplateBinding Background}"
                               Style="{StaticResource expandThumbStyle}"
                                Canvas.Top="{Binding Top, RelativeSource={RelativeSource TemplatedParent}}"
                               >
                                </Thumb>


                            </Canvas>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </MultiTrigger>

        </Style.Triggers>
    </Style>


    <Style TargetType="{x:Type local:TimeRangeControl}" x:Key="nonWorkingTimeRangeStyle"
           >
        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeChart}},Path=NonWorkingRangeBackground,FallbackValue=#d8d8d8}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsMilestone" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Canvas.Left" Value="{Binding Left, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                    <Canvas Width="{TemplateBinding TaskWidth}">
                        <Border Background="{TemplateBinding Background}"
                                Width="{TemplateBinding TaskWidth}"
                                Height="{TemplateBinding Height}"
                                >
                        </Border>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>




</ResourceDictionary>