<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows7.0;net9.0-windows7.0;net10.0-windows7.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.0.3</Version>
    <RootNamespace>FrostNova.Core.ExcelWork</RootNamespace>
    <AssemblyName>FrostNova.Core.ExcelWork.Npoi</AssemblyName>
    <PackageId>FrostNova.Core.ExcelWork.Npoi</PackageId>
    <Description>NPOI-based Excel (.xlsx) read/write helpers for FrostNova. A drop-in-style alternative to FrostNova.Core.ExcelWork that avoids EPPlus (Polyform Noncommercial) — NPOI is licensed under Apache-2.0, so both non-commercial and commercial use are free.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <!-- NPOI 2.8.0 uses SkiaSharp for image handling but declares it with exclude="Runtime",
         so the managed/native SkiaSharp assets do NOT flow to consumers. Reference it directly
         so AddImage works and SkiaSharp is deployed with apps that use this package. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\FrostNova.Core\FrostNova.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <PackageReference Include="FrostNova.Core" Version="1.1.2" />
  </ItemGroup>

</Project>
