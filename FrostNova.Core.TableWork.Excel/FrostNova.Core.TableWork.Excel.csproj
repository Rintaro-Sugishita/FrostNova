<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows7.0;net9.0-windows7.0;net10.0-windows7.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.2.1</Version>
    <Description>Excel (.xlsx) import/export for FrostNova.Core.TableWork, provided as ITableObject extension methods. Built on the Apache-2.0 NPOI backend (FrostNova.Core.ExcelWork.Npoi) so that the core TableWork package can stay free of any EPPlus (Polyform Noncommercial) dependency.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\FrostNova.Core.TableWork\FrostNova.Core.TableWork.csproj" />
    <ProjectReference Include="..\FrostNova.Core.ExcelWork.Npoi\FrostNova.Core.ExcelWork.Npoi.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <PackageReference Include="FrostNova.Core.TableWork" Version="1.2.0" />
    <PackageReference Include="FrostNova.Core.ExcelWork.Npoi" Version="0.0.3" />
  </ItemGroup>

</Project>
