<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
                    xmlns:att="clr-namespace:FrostNova.Core.Wpf.AttachedProperties;assembly=FrostNova.Core.Wpf"
                    >

    <SolidColorBrush x:Key="headerCellBackground">#f5f5f5</SolidColorBrush>
    <SolidColorBrush x:Key="selectedHeaderCellBackground">#caead8</SolidColorBrush>
    <SolidColorBrush x:Key="mouseOverHeaderCellBackground">#ebebeb</SolidColorBrush>
    <SolidColorBrush x:Key="allSelectedHeaderCellBackground">#107c41</SolidColorBrush>
    <SolidColorBrush x:Key="allSelectedMouseOverHeaderCellBackground">#0f703b</SolidColorBrush>
    <SolidColorBrush x:Key="allSelectedHeaderCellForeground">#FFFFFF</SolidColorBrush>
    <LinearGradientBrush x:Key="columnHeaderCellBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#d3d3d3" Offset="0"/>
        <GradientStop Color="#999999" Offset="1"/>
    </LinearGradientBrush>

    <!--Style of DataGridCell-->
    <Style x:Key="FrostNovaDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <!--<Setter Property="BorderThickness" Value="0"/>-->
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="#f0f0f0"/>
                <Setter Property="Background" Value="#f0f0f0"/>
                <Setter Property="Foreground" Value="Black" />


            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="Green"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--Style of DataGridRow-->
    <Style x:Key="FrostNovaDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource headerCellBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--Style of DataGridColumnHeader-->
    <Style x:Key="FrostNovaDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource headerCellBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource columnHeaderCellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource mouseOverHeaderCellBackground}"/>
            </Trigger>
            <!--<Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="Green" />
            </Trigger>-->
            <!--<DataTrigger Binding="{Binding }" />-->
            <Trigger Property="att:DataGridColumnHeaderEx.IsSelectedHeader" Value="True">
                <Setter Property="Background" Value="{StaticResource selectedHeaderCellBackground}"/>
            </Trigger>
            <Trigger Property="att:DataGridColumnHeaderEx.IsAllSelectedHeader" Value="True">
                <Setter Property="Background" Value="{StaticResource allSelectedHeaderCellBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource allSelectedHeaderCellForeground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="att:DataGridColumnHeaderEx.IsAllSelectedHeader" Value="True" />
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource allSelectedMouseOverHeaderCellBackground}" />
            </MultiTrigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedCells}" Value="{x:Null}">
                <Setter Property="Background" Value="Yellow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Style of RowHeader-->
    <Style x:Key="FrostNovaDataGridRowHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
        <Style.Triggers>
            <Trigger Property="IsRowSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource mouseOverHeaderCellBackground}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource mouseOverHeaderCellBackground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource mouseOverHeaderCellBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                <Setter Property="Background" Value="LightBlue" />
            </DataTrigger>
            <Trigger Property="att:DataGridRowHeaderEx.IsSelectedHeader" Value="True">
                <Setter Property="Background" Value="{StaticResource selectedHeaderCellBackground}"/>
            </Trigger>
            <Trigger Property="att:DataGridRowHeaderEx.IsAllSelectedHeader" Value="True">
                <Setter Property="Background" Value="{StaticResource allSelectedHeaderCellBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource allSelectedHeaderCellForeground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="att:DataGridRowHeaderEx.IsAllSelectedHeader" Value="True" />
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource allSelectedMouseOverHeaderCellBackground}" />
            </MultiTrigger>
        </Style.Triggers>
        <Setter Property="Background" Value="{StaticResource headerCellBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#a3a3a3" BorderThickness="0.5">
                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}"
                                                   Background="{TemplateBinding Property=Background}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,5,0" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MinWidth" Value="40" />
    </Style>


    <!--DataGridのスタイル-->
    <Style x:Key="FrostNovaDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="Cell" />
        <Setter Property="HorizontalGridLinesBrush" Value="#d4d4d4"/>
        <Setter Property="VerticalGridLinesBrush" Value="#d4d4d4"/>
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />

        <Setter Property="CellStyle" Value="{StaticResource FrostNovaDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource FrostNovaDataGridRowStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource FrostNovaDataGridColumnHeaderStyle}" />
        <Setter Property="RowHeaderStyle" Value="{StaticResource FrostNovaDataGridRowHeaderStyle}" />
        <Setter Property="behaviors:DataGridBehaviors.EnableRowNumberDisplay" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.EnableTablePaste" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.EnableCheckBoxSwitch" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.EnableCurrentCellValueCopy" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.EnableIsSelected" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.DataGridColumnIsSelect" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.DataGridHeaderClickSelect" Value="True" />
        <Setter Property="behaviors:DataGridBehaviors.ColumnVisibilityMenu" Value="True" />
        <Style.Triggers>
            <Trigger Property="ItemsSource" Value="{x:Null}">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
        </Style.Triggers>
    </Style>


    

</ResourceDictionary>