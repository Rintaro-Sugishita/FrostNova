<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>FrostNova.Core.NativeAOT</RootNamespace>
        <Description>NativeAOT optimized DeepClone source generator.</Description>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
     <Version>1.1.2</Version>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

        <ArtifactsPath Condition="'$(UseArtifactsOutput)' == 'false'"></ArtifactsPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="10.0.10" />
    </ItemGroup>
</Project>
