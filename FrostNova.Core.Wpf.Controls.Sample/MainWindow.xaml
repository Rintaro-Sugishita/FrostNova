<Window
    x:Class="FrostNova.Core.Wpf.Controls.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:att="clr-namespace:FrostNova.Core.Wpf.AttachedProperties;assembly=FrostNova.Core.Wpf"
    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
    xmlns:common="clr-namespace:FrostNova.Core.Wpf.Common;assembly=FrostNova.Core.Wpf"
    xmlns:conv="clr-namespace:FrostNova.Core.Wpf.Controls.Converters;assembly=FrostNova.Core.Wpf.Controls"
    xmlns:ctrls="clr-namespace:FrostNova.Core.Wpf.Controls;assembly=FrostNova.Core.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls.Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <common:BindingProxy x:Key="viewModelProxy" Data="{Binding}" />
        <sys:TimeSpan x:Key="timeOne">01:30:00</sys:TimeSpan>
        <sys:TimeSpan x:Key="minValueSource">00:00:00</sys:TimeSpan>
        <sys:TimeSpan x:Key="maxValueSource">24:00:00</sys:TimeSpan>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Time">
                <StackPanel>
                    <TextBox Text="{Binding Date}" />
                    <ctrls:TimePicker IsPartsDateTime="True" TimeValue="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Text="{Binding Span}" />
                    <ctrls:TimePicker
                        IsPartsDateTime="False"
                        IsShowSecond="True"
                        TimeValue="{Binding Span, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ctrls:FontComboBox />
                </StackPanel>
            </TabItem>

            <TabItem Header="TimePickerEditBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ctrls:TimePickerEditBox MinHeight="20" Height="30"
                                             HorizontalContentAlignment="Right"
                                             
                                             TimeValue="{StaticResource timeOne}"
                                             IsShowSecond="{Binding ElementName=secondCheckBox,Path=IsChecked}"
                                             IsShowDay="{Binding ElementName=dayCheckBox,Path=IsChecked}"
                                             TimePickerButtonVisibility="{Binding ElementName=pickerCheckBox,Path=IsChecked,Converter={StaticResource boolToVisibilityConverter}}"
                                             UpDownButtonVisibility="{Binding ElementName=updownCheckBox,Path=IsChecked,Converter={StaticResource boolToVisibilityConverter}}"
                                             MinuteSpan="{Binding ElementName=minuteSpanTextbox,Path=Text}"
                                             VerticalContentAlignment="Center"
                                             >
                        <ctrls:TimePickerEditBox.Style>
                            <Style TargetType="{x:Type ctrls:TimePickerEditBox}" BasedOn="{StaticResource {x:Type ctrls:TimePickerEditBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=minLimitCheckBox, Path=IsChecked}" Value="True">
                                        <Setter Property="MinValue" Value="{StaticResource minValueSource}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=minLimitCheckBox, Path=IsChecked}" Value="Fals">
                                        <Setter Property="MinValue" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=maxLimitCheckBox, Path=IsChecked}" Value="True">
                                        <Setter Property="MaxValue" Value="{StaticResource maxValueSource}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=maxLimitCheckBox, Path=IsChecked}" Value="Fals">
                                        <Setter Property="MaxValue" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrls:TimePickerEditBox.Style>
                    </ctrls:TimePickerEditBox>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="secondCheckBox" Content="Show Second" />
                        <CheckBox x:Name="dayCheckBox" Content="Show Day" />
                        <CheckBox x:Name="pickerCheckBox" Content="Visible Picker" />
                        <CheckBox x:Name="updownCheckBox" Content="Visible UpDown" IsChecked="True" />
                        <CheckBox x:Name="minLimitCheckBox" Content="Limit min value to Zero" />
                        <CheckBox x:Name="maxLimitCheckBox" Content="Limit max value to 23:59" />
                        <TextBox x:Name="minuteSpanTextbox" Text="10" IsReadOnly="False" />
                    </StackPanel>
                </Grid>



            </TabItem>

            <TabItem Header="Limit TextBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBox 
                        att:TextBoxInput.IntegerDigits="{Binding ElementName=intDigitText,Path=Text}"
                        att:TextBoxInput.DecimalDigits="{Binding ElementName=decDigitText,Path=Text}"
                        att:TextBoxInput.FormatType="{Binding ElementName=inputTypeCombo, Path=SelectedValue}"
                        att:TextBoxInput.DateTimeFormat="{Binding ElementName=dateCombo, Path=SelectedValue}"
                        att:TextBoxInput.AllowedCharTypes="{Binding TestCharType}"
                        behaviors:TextBoxBehaviors.EnableTextInputLimit="True"
                        >
                        
                    </TextBox>
                    <StackPanel Grid.Column="1">
                        <ComboBox x:Name="inputTypeCombo"
                                  SelectedValuePath="Content"
                                  SelectedIndex="0" 
                                  
                                  >
                            <!--<ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>-->
                            <ComboBox.Items>
                                <ComboBoxItem Content="{x:Static att:InputFormatType.None}" />
                                <ComboBoxItem Content="{x:Static att:InputFormatType.Integer}" />
                                <ComboBoxItem Content="{x:Static att:InputFormatType.Decimal}" />
                                <ComboBoxItem Content="{x:Static att:InputFormatType.DateTime}" />
                            </ComboBox.Items>
                        </ComboBox>
                        <TextBox x:Name="intDigitText" >5</TextBox>
                        <TextBox x:Name="decDigitText" >3</TextBox>
                        <ComboBox x:Name="dateCombo"
                                  SelectedValuePath="Content"
                                  SelectedIndex="1"
                                  >
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.None}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.yyyyMMddHHmmss}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.yyyyMMdd}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.yyyyMM}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.d}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.HHmmss}" />
                            <ComboBoxItem Content="{x:Static att:DateTimeFormatType.HHmm}" />
                        </ComboBox>
                        <CheckBox Content="{x:Static att:AllowedCharTypes.Digit}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.Digit}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.LowerAlpha}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.LowerAlpha}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.UpperAlpha}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.UpperAlpha}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.HalfWidthSymbol}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.HalfWidthSymbol}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.Hiragana}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.Hiragana}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.Katakana}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.Katakana}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.HalfKana}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.HalfKana}}" />
                        <CheckBox Content="{x:Static att:AllowedCharTypes.FullWidth}" IsChecked="{Binding Path=TestCharType, Converter={StaticResource enumFlagsBoolConverter},Mode=TwoWay,ConverterParameter={x:Static att:AllowedCharTypes.FullWidth}}" />
                    </StackPanel>
                </Grid>
                
            </TabItem>

            <TabItem Header="NumericUpdown" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ctrls:NumericUpDown Height="20" />
                </Grid>
            </TabItem>
            
            <TabItem Header="Color">
                <StackPanel>
                    <ctrls:ColorSelector />
                    <Button Command="{Binding ShowColorDialogCommand}" Content="select" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            MinWidth="200"
                            HorizontalAlignment="Stretch"
                            Text="{Binding SelectedColor, Converter={StaticResource colorTextConverter}, Mode=TwoWay}" />
                        <ctrls:ColorPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox MinWidth="200" HorizontalAlignment="Stretch" />
                        <ctrls:ColorPicker IsDialogMode="True" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="DataGrid1" IsSelected="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <DataGrid
                        att:DataGridEx.SelectedItems="{Binding SelectedSamples}"
                        att:DataGridEx.SelectedItemsChangeCommand="{Binding SelectedItemsChangedCommand}"
                        att:DataGridEx.IsEditOnEnter="{Binding ElementName=alwaysEditCheckbox, Path=IsChecked}"
                        ItemsSource="{Binding Samples}">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridRowNumberDisplayBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <ctrls:FrostNovaDataGridTextBoxColumn Binding="{Binding ColumnValue}" Header="Column1" />
                            <ctrls:FrostNovaDataGridTextBoxColumn Binding="{Binding NumValue}" Header="Column2"
                                                                  TextBlock.TextAlignment="Right"
                                                                  >
                            </ctrls:FrostNovaDataGridTextBoxColumn>
                            <ctrls:FrostNovaDataGridTextBoxColumn
                                Binding="{Binding MultiLineText}"
                                CanLineBreak="{Binding Data.CanLineBreak, Source={StaticResource viewModelProxy}, Mode=TwoWay}"
                                Header="custom1"
                                />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBox />
                                            <TextBox Grid.Row="1" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>


                    </DataGrid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding SelectedIndices}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" />
                                        <TextBlock Text="index row is selected." />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1">
                            <CheckBox Content="CanLineBreak" IsChecked="{Binding CanLineBreak, Mode=TwoWay}" />
                            <CheckBox x:Name="alwaysEditCheckbox" Content="AlwaysEdit" IsChecked="True" />
                        </StackPanel>

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="DataGrid2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <DataGrid
                        att:DataGridEx.ExtColumns="{Binding ExtCols}"
                        att:DataGridEx.ExtColumnInsertIndex="1"
                        att:DataGridEx.IsEditOnEnter="{Binding IsChecked, ElementName=editOnEnterCheckBox}"
                        ItemsSource="{Binding Samples2}">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridRowNumberDisplayBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ColumnValue}" Header="Column1" />
                        </DataGrid.Columns>


                    </DataGrid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding ColTypes}" SelectedValue="{Binding SelectedColType}" />
                            <Button Command="{Binding AddCustomColumnCommand}" >Add</Button>
                            <Button Command="{Binding ApplyToCommand}" >apply to aaa</Button>
                            <CheckBox Content="AlwaysEdit" x:Name="editOnEnterCheckBox" />
                        </StackPanel>

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="messagebox">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                            <Setter Property="Height" Value="40" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding ShowErrorMessageCommand}" Content="show error" />
                    <Button Command="{Binding ShowMultiLineMessageCommand}" Content="show error" />
                    <Button Command="{Binding ShowWarningMessageCommand}" Content="show error" />
                </StackPanel>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
