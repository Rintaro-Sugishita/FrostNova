<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Company></Company>
    <PackageOutputPath>$(SolutionDir).localNuget</PackageOutputPath>

    <Authors>R.Sugishita</Authors>
    <RepositoryUrl>https://github.com/Rintaro-Sugishita/FrostNova</RepositoryUrl>

   <EmitEmbeddedSources>true</EmitEmbeddedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <NupkgCopyDestination>$(SolutionDir)\.LocalNuget</NupkgCopyDestination>
  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <Now>$([System.DateTime]::Now.ToString("yyyyMMddHHmm"))</Now>
    <VersionPrefix>0.0.6-dev</VersionPrefix>
    <VersionSuffix>$(Now)</VersionSuffix>

  </PropertyGroup>
  <Target Name="CopyNupkgAfterEachPack"
            AfterTargets="Pack"
            DependsOnTargets="Pack"
            Condition="Exists('$(OutputPath)')">
      <ItemGroup>
        <BuiltNupkgFiles Include="$(OutputPath)\$(PackageId).$(PackageVersion).nupkg" />
      </ItemGroup>

      <!-- <MakeDir Directories="$(NupkgCopyDestination)" />

      <Copy
        SourceFiles="@(BuiltNupkgFiles)"
        DestinationFolder="$(NupkgCopyDestination)"
        SkipUnchangedFiles="true"
        Condition="@(BuiltNupkgFiles) != ''" /> -->
  </Target>
  <ItemGroup>
    <PackageVersion Include="FrostNova.Core" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Wpf" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Wpf.Controls" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.Registry" Version="0.0.8" />
    <PackageVersion Include="FrostNova.Core.ExcelWork" Version="0.0.8" />
    <PackageVersion Include="FrostNova.TimeRangeChart" Version="0.0.8" />
    <PackageVersion Include="FrostNova.TimeRangeChart.Wpf" Version="0.0.8" />
    <PackageVersion Include="FrostNova.WindowEventPickers" Version="0.0.8" />
  </ItemGroup>


</Project>
