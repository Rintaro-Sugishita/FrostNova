<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 
    <Style x:Key="FrostNovaButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="2, 1, 2, 1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="White" BorderBrush="#ADADAD" BorderThickness="1" CornerRadius="4">
                        <!--<Border.Effect>
                            <DropShadowEffect BlurRadius="4" Direction="-90" RenderingBias="Quality" ShadowDepth="0"/>
                        </Border.Effect>-->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border.Resources>
                            <Storyboard x:Key="RippleAnimation" Storyboard.TargetName="rippleEllipse">
                                <DoubleAnimation Storyboard.TargetProperty="Width" From="0" Duration="0:0:0.5"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" BeginTime="0:0:0.5" Duration="0:0:0"/>
                            </Storyboard>
                        </Border.Resources>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OkButtonStyle" TargetType="Button" BasedOn="{StaticResource ResourceKey=FrostNovaButtonStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="Green" VerticalAlignment="Center">&#xF78C;</TextBlock>
                        <TextBlock Margin="5,0,0,0">OK</TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ResourceKey=FrostNovaButtonStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="#BB0000" VerticalAlignment="Center">&#xF78A;</TextBlock>
                        <TextBlock Margin="5,0,0,0">Cancel</TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>