<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows7.0;net9.0-windows7.0;net10.0-windows7.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Version>1.1.0</Version>
    <Description>Windows Registry / shell-integration helpers: auto-start entries, file-type associations, and Explorer context-menu verbs. Per-user (no-admin) by default.</Description>
    <PackageReleaseNotes>
      1.1.0
      - Add ContextMenuManager (register/unregister Explorer right-click verbs for files, folders, and folder background).
      - FileAssociationManager: add Unregister / IsRegistered and call SHChangeNotify so the shell refreshes immediately.
      - File associations and context menus are now per-user (HKCU\Software\Classes, no admin) by default; machine-wide registration is available via separate ...ForAllUsers methods (require elevation). NOTE: the previous FileAssociationManager.Register wrote machine-wide (HKEY_CLASSES_ROOT); it now writes per-user.
      - Fix StartupManager.RegisterStartup dropping the executable path when arguments were supplied.
    </PackageReleaseNotes>
  </PropertyGroup>

</Project>
