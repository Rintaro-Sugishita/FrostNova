<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FrostNova.Core.Wpf.Behaviors;assembly=FrostNova.Core.Wpf"
    xmlns:cnv="clr-namespace:FrostNova.Core.Wpf.Converters;assembly=FrostNova.Core.Wpf"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wpfCommon="clr-namespace:FrostNova.Core.Wpf.Common;assembly=FrostNova.Core.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cnv:DateTimeFormatConverter x:Key="dateConverter" />
    <cnv:BorderThicknessConverter x:Key="borderThicknessConverter" />


    <Style x:Key="virtualContainerListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <!--<ScrollViewer Focusable="false"
                      Padding="0"
                      Background="Transparent">-->
                    <ItemsPresenter />
                    <!--</ScrollViewer>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="virtualListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        HorizontalAlignment="Stretch"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="defaultGridTimeRangeChartStyle" TargetType="{x:Type local:GridTimeRangeChart}">

        <!--  カラムヘッダのデフォルトスタイル  -->
        <Setter Property="ColumnHeaderTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type local:RuledLineData}">
                    <Border
                        Width="{Binding WidthPerRuledLine}"
                        Background="Transparent"
                        BorderBrush="{Binding RuledLineFill}">
                        <Border.BorderThickness>
                            <MultiBinding Converter="{StaticResource borderThicknessConverter}">
                                <Binding Path="RuledLineThickness" />
                                <Binding Path="RuledLineThickness" />
                                <Binding Mode="OneTime">
                                    <Binding.Source>
                                        <sys:Double>0</sys:Double>
                                    </Binding.Source>
                                </Binding>
                                <Binding Path="RuledLineThickness" />
                            </MultiBinding>
                        </Border.BorderThickness>
                        <TextBlock HorizontalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource dateConverter}">
                                    <Binding Path="DateValue" />
                                    <Binding Path="HeaderFormat" />
                                </MultiBinding>
                            </TextBlock.Text>

                        </TextBlock>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridTimeRangeChart}">
                    <Grid>
                        <Grid.Resources>
                            <wpfCommon:BindingProxy x:Key="gridChartProxy" Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--  row and column header  -->
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0.5">
                            <ContentPresenter
                                x:Name="allHeader"
                                Content="{TemplateBinding CornerHeaderSource}"
                                ContentTemplate="{TemplateBinding CornerHeaderTemplate}"
                                ContentTemplateSelector="{TemplateBinding CornerHeaderTemplateSelector}" />
                        </Border>


                        <!--  row header  -->
                        <ScrollViewer
                            x:Name="rowScrollViewer"
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalScrollBarVisibility="Visible"
                            VerticalScrollBarVisibility="Hidden">
                            <i:Interaction.Behaviors>
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="False"
                                    IsVerticalSync="True"
                                    ReflectViewer="{Binding ElementName=chartScrollViewer}" />
                                <behaviors:ScrollViewerTopLeftItemBehavior
                                    BottomVisibleItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}, Path=ScrollBottomItem, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                    TargetItemsControl="{Binding ElementName=rowHeaderListBox}"
                                    TopVisibleItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}, Path=ScrollTopItem, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
                            </i:Interaction.Behaviors>
                            <!--<ItemsControl
                                      ItemsSource="{TemplateBinding ItemsSource}"
                                      ItemTemplate="{TemplateBinding Property=RowHeaderTemplate}"
                                      ItemTemplateSelector="{TemplateBinding Property=RowHeaderTemplateSelector}"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      MinWidth="{TemplateBinding MinRowWidth}"
                                      >
                                <i:Interaction.Behaviors>
                                    <behaviors:ItemsControlHeightSyncBehavior TargetItemsControl="{Binding ElementName=chartItemsControl}" />
                                </i:Interaction.Behaviors>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="{x:Type ContentPresenter}">
                                        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=RowHeight}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>-->
                            <ListBox
                                x:Name="rowHeaderListBox"
                                MinWidth="{TemplateBinding MinRowWidth}"
                                ItemTemplate="{TemplateBinding RowHeaderTemplate}"
                                ItemTemplateSelector="{TemplateBinding RowHeaderTemplateSelector}"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                Style="{StaticResource virtualContainerListBoxStyle}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ItemsControlHeightSyncBehavior TargetItemsControl="{Binding ElementName=chartItemsControl}" />
                                </i:Interaction.Behaviors>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource virtualListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                        </ScrollViewer>

                        <GridSplitter
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="4"
                            HorizontalAlignment="Stretch" />
                        <GridSplitter
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="4"
                            HorizontalAlignment="Stretch" />


                        <!--  column header  -->
                        <!--  datetimeアイテムを横に並べていく  -->
                        <ScrollViewer
                            x:Name="columnScrollViewer"
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                            <i:Interaction.Behaviors>
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="True"
                                    IsVerticalSync="False"
                                    ReflectViewer="{Binding ElementName=columnScrollViewer}" />
                                <behaviors:ScrollViewerTopLeftItemBehavior
                                    BottomVisibleItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}, Path=ScrollRightDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    CenterVisibleItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}, Path=ScrollCenterDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TargetItemsControl="{Binding ElementName=columnHeaderControl}"
                                    TopVisibleItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:GridTimeRangeChart}}, Path=ScrollLeftDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </i:Interaction.Behaviors>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <!--  グループの方  -->
                                <ItemsControl Grid.Row="0" />

                                <!--  細かい方  -->

                                <ItemsControl
                                    x:Name="columnHeaderControl"
                                    Grid.Row="1"
                                    ItemTemplate="{TemplateBinding Property=ColumnHeaderTemplate}"
                                    ItemTemplateSelector="{TemplateBinding Property=ColumnHeaderTemplateSelector}"
                                    ItemsSource="{TemplateBinding TimeTicksForColumnHeader}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>



                                </ItemsControl>
                                <!--<ListBox  Grid.Row="1" ItemsSource="{TemplateBinding TimeTicks}"
                                     Style="{StaticResource virtualContainerListBoxStyle}"
                                     ItemTemplate="{TemplateBinding ColumnHeaderTemplate}"
                                     ItemTemplateSelector="{TemplateBinding ColumnHeaderTemplateSelector}"
                                     >
                                    <i:Interaction.Behaviors>
                                        <behaviors:ItemsControlHeightSyncBehavior TargetItemsControl="{Binding ElementName=chartItemsControl}" />
                                    </i:Interaction.Behaviors>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource virtualListBoxItemStyle}">
                                            <Setter Property="BorderThickness" Value="0,0,0,0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>-->

                                <!--<ListBox x:Name="chartItemsControl" Grid.Row="1"
         ItemsSource="{TemplateBinding ItemsSource}"
         ScrollViewer.CanContentScroll="True"
         VirtualizingStackPanel.IsVirtualizing="True"
                                         ItemTemplate="{TemplateBinding Property=ColumnHeaderTemplate}"
         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>-->
                            </Grid>
                        </ScrollViewer>


                        <!--  chart  -->
                        <ScrollViewer
                            x:Name="chartScrollViewer"
                            Grid.Row="1"
                            Grid.Column="2"
                            HorizontalScrollBarVisibility="Visible"
                            PanningMode="Both"
                            VerticalScrollBarVisibility="Visible">
                            <i:Interaction.Behaviors>
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="False"
                                    IsVerticalSync="True"
                                    ReflectViewer="{Binding ElementName=rowScrollViewer}" />
                                <behaviors:ScrollSyncBehavior
                                    IsHorizontalSync="True"
                                    IsVerticalSync="False"
                                    ReflectViewer="{Binding ElementName=columnScrollViewer}" />
                                <behaviors:ScrollGestureBehavior />
                            </i:Interaction.Behaviors>

                            <!--<ItemsControl Name="chartItemsControl" ItemsSource="{TemplateBinding ItemsSource}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:TimeRangeChart StartTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.StartTime}"
                                                              EndTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.EndTime}"
                                                              ScaleIncrement="{Binding Source={StaticResource gridChartProxy}, Path=Data.ScaleIncrement}"
                                                              WidthPerRuledLine="{Binding Source={StaticResource gridChartProxy}, Path=Data.WidthPerRuledLine}"
                                                              MinSpan="{Binding Source={StaticResource gridChartProxy}, Path=Data.MinSpan}"
                                                              RuledLineFill="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineFill}"
                                                              RuledLineThickness="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineThickness}"
                                                              TimeRangeStyle="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeRangeStyle,FallbackValue={StaticResource timeRangeControlStyle}}"
                                                              Style="{Binding Source={StaticResource gridChartProxy}, Path=Data.ChartStyle}"
                                                              TimeTicks="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeTicks}"
                                                              IsControlTick="False"

                                                              />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="{x:Type ContentPresenter}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>-->
                            <ListBox
                                x:Name="chartItemsControl"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                ScrollViewer.CanContentScroll="True"
                                Style="{StaticResource virtualContainerListBoxStyle}"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <local:TimeRangeChart
                                            Height="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=ActualHeight}"
                                            AllowDrop="True"
                                            Background="{Binding Source={StaticResource gridChartProxy}, Path=Data.Background}"
                                            BorderBrush="Gray"
                                            CanDragTasksBetweenRows="{Binding Source={StaticResource gridChartProxy}, Path=Data.CanDragTasksBetweenRows}"
                                            EndTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.EndTime}"
                                            IsControlTick="False"
                                            MinSpan="{Binding Source={StaticResource gridChartProxy}, Path=Data.MinSpan}"
                                            NonWorkingRangeBackground="{Binding Source={StaticResource gridChartProxy}, Path=Data.NonWorkingRangeBackground}"
                                            ParentGridChart="{Binding Source={StaticResource gridChartProxy}, Path=Data, Mode=OneTime}"
                                            RuledLineFill="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineFill}"
                                            RuledLineThickness="{Binding Source={StaticResource gridChartProxy}, Path=Data.RuledLineThickness}"
                                            ScaleIncrement="{Binding Source={StaticResource gridChartProxy}, Path=Data.ScaleIncrement}"
                                            SelectedRanges="{Binding Source={StaticResource gridChartProxy}, Path=Data.SelectedRanges}"
                                            SelectedValues="{Binding Source={StaticResource gridChartProxy}, Path=Data.SelectedValues}"
                                            StartTime="{Binding Source={StaticResource gridChartProxy}, Path=Data.StartTime}"
                                            Style="{Binding Source={StaticResource gridChartProxy}, Path=Data.ChartStyle}"
                                            TimeRangeStyle="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeRangeStyle, FallbackValue={StaticResource timeRangeControlStyle}}"
                                            TimeTicks="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeTicks}"
                                            TimeUnit="{Binding Source={StaticResource gridChartProxy}, Path=Data.TimeUnit}"
                                            WidthPerRuledLine="{Binding Source={StaticResource gridChartProxy}, Path=Data.WidthPerRuledLine}">
                                            <!--<i:Interaction.Behaviors>
                                                <behaviors:DragDropBehavior />
                                            </i:Interaction.Behaviors>-->

                                        </local:TimeRangeChart>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource virtualListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </ScrollViewer>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>


</ResourceDictionary>