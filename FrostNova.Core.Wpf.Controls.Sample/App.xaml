                <ResourceDictionary Source="pack://application:,,,/FrostNova.Core.Wpf.Controls;component/Themes/FrostNovaCustomDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
