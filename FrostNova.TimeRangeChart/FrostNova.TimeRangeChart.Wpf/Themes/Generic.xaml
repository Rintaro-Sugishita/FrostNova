<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeControlStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/TimeRangeChartStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.TimeRangeChart.Wpf;component/Themes/GridTimeRangeChartStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:GridTimeRangeChart}" BasedOn="{StaticResource defaultGridTimeRangeChartStyle}" />
    <Style TargetType="{x:Type local:TimeRangeControl}" BasedOn="{StaticResource timeRangeControlStyle}" />

    <Style TargetType="{x:Type local:TimeRangeChart}" BasedOn="{StaticResource defaultTimeRangeChartStyle}" />

</ResourceDictionary>
