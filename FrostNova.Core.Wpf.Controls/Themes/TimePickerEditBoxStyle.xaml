<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    
                    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/Customs/ToggleButtonStyleDictionary.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/TimePickerStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf;component/Resources/Converters.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/Customs/TextBoxStyleDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="defaultFrostNovaTimePickerEditBoxStyle" TargetType="{x:Type local:TimePickerEditBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimePickerEditBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox                                  >
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource FrostNovaTextBoxStyle}"                                   
                                   >
                                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=Background}" />
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=Foreground}" />
                                    <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=FontFamily}" />
                                    <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=FontSize}" />
                                    <Setter Property="HorizontalAlignment" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=HorizontalAlignment}" />
                                    <Setter Property="HorizontalContentAlignment" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=HorizontalContentAlignment}" />
                                    <!--<Setter Property="VerticalAlignment" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=VerticalAlignment}" />-->
                                    <!--<Setter Property="VerticalContentAlignment" Value="{TemplateBinding VerticalContentAlignment}" />-->
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <!--<Style.Triggers>
                                        <DataTrigger Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeConverter}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeValue, Mode=TwoWay,StringFormat='hh\\:mm'}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeConverter,Converter={StaticResource isNullConverter}}" Value="False">
                                            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeValue, Mode=TwoWay,Converter={Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeConverter}}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=IsShowSecond}" Value="True">
                                            <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeValue, Mode=TwoWay,StringFormat='hh\\:mm\\:ss'}" />
                                        </DataTrigger>
                                    </Style.Triggers>-->
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource timeSpanToTextConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimePickerEditBox}}" Path="TimeValue" />
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimePickerEditBox}}" Path="IsShowSecond" />
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:TimePickerEditBox}}" Path="IsShowDay" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <local:TimePicker Grid.Column="1" MinWidth="30"
                                          TimeValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=TimeValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          HourValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=HourValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          MinuteValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=MinuteValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          SecondValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimePickerEditBox}},Path=SecondValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                                                   
                                          MinuteSpan="{TemplateBinding MinuteSpan}"
                                          SecondSpan="{TemplateBinding SecondSpan}"
                                          
                                          IsPartsDateTime="{TemplateBinding IsPartsDateTime}"
                                          IsShowSecond="{TemplateBinding IsShowSecond}"
                                          
                                          MaxPopupHeight="{TemplateBinding MaxPopupHeight}"
                                          MinPopupHeight="{TemplateBinding MinPopupHeight}"
                                          PopupHeight="{TemplateBinding PopupHeight}"
                                          
                                          MaxPopupWidth="{TemplateBinding MaxPopupWidth}"
                                          MinPopupWidth="{TemplateBinding MinPopupWidth}"
                                          PopupWidth="{TemplateBinding PopupWidth}"
                                          
                                          Placement="{TemplateBinding Placement}"
                                          PlacementTarget="{TemplateBinding PlacementTarget}"
                                          Visibility="{TemplateBinding TimePickerButtonVisibility}"
                                          Height="{TemplateBinding Height}"
                                          />
                        <Grid Grid.Column="2" MinWidth="30"
                              Visibility="{TemplateBinding UpDownButtonVisibility}"
                              >
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Button x:Name="PART_UpButton"  FontFamily="Segoe Fluent Icons" Padding="-5,-5,0,0" >&#xe971;</Button>
                            <Button x:Name="PART_DownButton" Grid.Row="1"   FontFamily="Segoe Fluent Icons">&#xe972;</Button>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>