<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FrostNova.TimeRangeChart.Wpf"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:cnv="clr-namespace:FrostNova.Core.Wpf.Converters;assembly=FrostNova.Core.Wpf"
                    xmlns:timeRangeBase="clr-namespace:FrostNova.TimeRangeChart;assembly=FrostNova.TimeRangeChart"
                    xmlns:timeRangeHelpers="clr-namespace:FrostNova.TimeRangeChart.TimeRangeHelpers;assembly=FrostNova.TimeRangeChart"
                    xmlns:localConv="clr-namespace:FrostNova.TimeRangeChart.Wpf.Converters"
                    >

    <localConv:RangeContentPaddingConverter x:Key="RangeContentPaddingConverter" />
    <localConv:NegativeMarginConverter x:Key="negativeMarginConverter" />
    <localConv:MilestoneCenterConverter x:Key="MilestoneCenterConverter" />
    <localConv:MilestoneCellSizeConverter x:Key="MilestoneCellSizeConverter" />

    <cnv:BorderThicknessConverter x:Key="borderThicknessConverter" />


    <sys:Double x:Key="expandWidth">7</sys:Double>


    <DataTemplate x:Key="diamondMilestoneTemplate">
        <Polygon x:Name="diamondMilestone" Points="0.5,0 1,0.5 0.5,1 0,0.5" 
             Stretch="Fill"
                Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=SymbolSize}" 
                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=SymbolSize}"
                                                    Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Background}"
                                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=BorderBrush}"
                                                     >
        </Polygon>
    </DataTemplate>

    <DataTemplate x:Key="circleMilestoneTemplate">
        <Ellipse x:Name="circleMilestone"
                Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=SymbolSize}" 
                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=SymbolSize}"
                Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=Background}"
                Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=BorderBrush}"
                    >
        </Ellipse>

    </DataTemplate>

    <DataTemplate x:Key="squareMilestoneTemplate">
        <Rectangle Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
               Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
               Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
               Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="triangleMilestoneTemplate">
        <Polygon Points="0,1 0.5,0 1,1" Stretch="Fill"
             Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
             Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="crossMilestoneTemplate">
        <Path Data="M 0,0.5 L 1,0.5 M 0.5,0 L 0.5,1" Stretch="Fill"
          Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
          Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          StrokeThickness="2" />
    </DataTemplate>

    <DataTemplate x:Key="xMilestoneTemplate">
        <Path Data="M 0,0 L 1,1 M 0,1 L 1,0" Stretch="Fill"
          Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
          Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          StrokeThickness="2" />
    </DataTemplate>

    <DataTemplate x:Key="invertedTriangleMilestoneTemplate">
        <Polygon Points="0,0 1,0 0.5,1" Stretch="Fill"
             Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
             Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="starMilestoneTemplate">
        <Path Data="M 0.5,0 L 0.61,0.35 L 0.98,0.35 L 0.68,0.57 L 0.79,0.91 L 0.5,0.7 L 0.21,0.91 L 0.32,0.57 L 0.02,0.35 L 0.39,0.35 Z" 
          Stretch="Fill"
          Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
          Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
          Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="hexagonMilestoneTemplate">
        <Polygon Points="0.25,0 0.75,0 1,0.5 0.75,1 0.25,1 0,0.5" Stretch="Fill"
             Width="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" 
             Height="{Binding SymbolSize, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="arrowUpMilestoneTemplate">
        <Path Data="M 50,0 L 100,60 L 70,60 L 70,100 L 30,100 L 30,60 L 0,60 Z" Stretch="Fill"
             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    <DataTemplate x:Key="arrowDownMilestoneTemplate">
        <Path Data="M 30,0 L 70,0 L 70,40 L 100,40 L 50,100 L 0,40 L 30,40 Z" Stretch="Fill"
             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}"
             Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}}}" />
    </DataTemplate>

    
    <Style TargetType="{x:Type local:TimeRangeControl}" x:Key="timeRangeControlStyle">
        <Setter Property="Background" Value="Orange"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectedBorderThickness" Value="3"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                    <Grid Background="Transparent">
                        <Border x:Name="MainBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Cursor="Hand"

                                >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="LeftHandle" Width="{StaticResource expandWidth}" HorizontalAlignment="Left" 
                            Background="White" CornerRadius="4"  Margin="1,3"  Visibility="Collapsed" Cursor="SizeWE"/>

                        <Border x:Name="RightHandle" Width="{StaticResource expandWidth}" HorizontalAlignment="Right" 
                           Background="White" CornerRadius="4"  Margin="1,3"  Visibility="Collapsed"  Cursor="SizeWE"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" 
                Value="{Binding SelectedBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="MainBorder" Property="BorderThickness" 
                Value="{Binding SelectedBorderThickness, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanExpandSpan" Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="LeftHandle" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="RightHandle" Property="Visibility" Value="Visible"/>

                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanDrag" Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="MainBorder" Property="Cursor" Value="Hand"/>

                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMilestone" Value="True">
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TimeRangeControl}">
                            <Grid x:Name="MainGrid" Background="Transparent" ClipToBounds="False">
                                <Grid.RenderTransform>

                                    <TranslateTransform>
                                        <TranslateTransform.X>
                                            <MultiBinding Converter="{StaticResource MilestoneCenterConverter}" ConverterParameter="X">
                                                <Binding Path="SymbolSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding ElementName="LabelPart" Path="ActualWidth"/>
                                                <Binding Path="LabelPosition" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            </MultiBinding>
                                        </TranslateTransform.X>
                                    </TranslateTransform>

                                </Grid.RenderTransform>

                                <Grid ClipToBounds="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelSide"/>

                                        <ColumnDefinition>
                                            <ColumnDefinition.Width>
                                                <MultiBinding Converter="{StaticResource MilestoneCellSizeConverter}" ConverterParameter="Width">
                                                    <Binding Path="SymbolSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    <Binding ElementName="LabelPart" Path="ActualWidth"/>
                                                    <Binding Path="LabelPosition" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    <Binding Path="LabelSpacing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                </MultiBinding>
                                            </ColumnDefinition.Width>
                                        </ColumnDefinition>

                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelSide"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="LabelSide"/>
                                        <RowDefinition Height="{Binding SymbolSize, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <RowDefinition Height="Auto" SharedSizeGroup="LabelSide"/>
                                    </Grid.RowDefinitions>

                                    <ContentControl x:Name="SymbolPart"
                            Grid.Column="1" Grid.Row="1"
                            Width="{TemplateBinding SymbolSize}" 
                            Height="{TemplateBinding SymbolSize}">
                                        <ContentControl.Margin>
                                            <MultiBinding Converter="{StaticResource negativeMarginConverter}">
                                                <Binding ElementName="Col0Item" Path="ActualWidth"/>
                                                <Binding ElementName="Row0Item" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </ContentControl.Margin>
                                        <ContentControl.Style>
                                            <Style TargetType="{x:Type ContentControl}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=MilestoneType}" Value="{x:Static timeRangeBase:MilestoneStyle.Diamond}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource diamondMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:TimeRangeControl}},Path=MilestoneType}" Value="{x:Static timeRangeBase:MilestoneStyle.Circle}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource circleMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.Square}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource squareMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.Triangle}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource triangleMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.Cross}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource crossMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.X}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource xMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.InvertedTriangle}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource invertedTriangleMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.Star}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource starMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.Hexagon}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource hexagonMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.ArrowDown}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource arrowDownMilestoneTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MilestoneType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static timeRangeBase:MilestoneStyle.ArrowUp}">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource arrowUpMilestoneTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>

                                    </ContentControl>

                                    <ContentPresenter x:Name="LabelPart"
                              Grid.Column="2" Grid.Row="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="4,0,0,0" />

                                    <FrameworkElement x:Name="Col0Item" Grid.Column="0" Visibility="Collapsed"/>
                                    <FrameworkElement x:Name="Row0Item" Grid.Row="0" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="LabelPosition" Value="Left">
                                    <Setter TargetName="LabelPart" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="LabelPart" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="LabelPart" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="LabelPart" Property="VerticalAlignment" Value="Center"/>
                                    <Setter TargetName="LabelPart" Property="Margin" Value="0,0,4,0"/>
                                </Trigger>

                                <Trigger Property="LabelPosition" Value="Top">
                                    <Setter TargetName="LabelPart" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="LabelPart" Property="Grid.Row" Value="0"/>
                                    <Setter TargetName="LabelPart" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="LabelPart" Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter TargetName="LabelPart" Property="Margin" Value="0,0,0,4"/>
                                </Trigger>

                                <Trigger Property="LabelPosition" Value="Right">
                                    <Setter TargetName="LabelPart" Property="Grid.Column" Value="2"/>
                                    <Setter TargetName="LabelPart" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="LabelPart" Property="HorizontalAlignment" Value="Left"/>
                                    <Setter TargetName="LabelPart" Property="VerticalAlignment" Value="Center"/>
                                    <Setter TargetName="LabelPart" Property="Margin" Value="4,0,0,0"/>
                                </Trigger>

                                <Trigger Property="LabelPosition" Value="Bottom">
                                    <Setter TargetName="LabelPart" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="LabelPart" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="LabelPart" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="LabelPart" Property="VerticalAlignment" Value="Top"/>
                                    <Setter TargetName="LabelPart" Property="Margin" Value="0,4,0,0"/>
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="CanDrag" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="SymbolPart" Property="Cursor" Value="Hand" />
                                </MultiTrigger>

                            </ControlTemplate.Triggers>







                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>

    </Style>

</ResourceDictionary>
