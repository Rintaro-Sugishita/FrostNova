<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:att="clr-namespace:FrostNova.Core.Wpf.AttachedProperties;assembly=FrostNova.Core.Wpf"
                    xmlns:local="clr-namespace:FrostNova.Core.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostNova.Core.Wpf.Controls;component/Themes/ColorSliderStyle.xaml" />
        <ResourceDictionary Source="/FrostNova.Core.Wpf;component/Resources/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 水平スライダー共通スタイル -->
    <Style x:Key="colorSelectorSliderStyle" BasedOn="{StaticResource colorSliderStyle}" TargetType="{x:Type Slider}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="255"/>
        <Setter Property="LargeChange" Value="1"/>
        <Setter Property="SmallChange" Value="1"/>
    </Style>

    <!-- 垂直スライダー (A: 0-255) -->
    <Style x:Key="colorSelectorVSliderStyle" BasedOn="{StaticResource colorSliderStyle}" TargetType="{x:Type Slider}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="255"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- 垂直スライダー (S/L: 0.0-1.0) -->
    <Style x:Key="colorSelectorVdoubleSliderStyle" BasedOn="{StaticResource colorSliderStyle}" TargetType="{x:Type Slider}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1.0"/>
        <Setter Property="LargeChange" Value="0.02"/>
        <Setter Property="SmallChange" Value="0.01"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="0.01"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ColorSelector 本体 -->
    <Style x:Key="defaultColorSelectorStyle" TargetType="{x:Type local:ColorSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                          DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ColorSelector}}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- ═══ 色相グラデーション バー ═══ -->
                        <Grid Grid.Row="0">
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="{Binding GradientOffsetFF0000}"  Color="{Binding ColorFF0000Brush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffsetFFFF00}"  Color="{Binding ColorFFFF00Brush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffset00FF00}"  Color="{Binding Color00FF00Brush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffset00FFFF}"  Color="{Binding Color00FFFFBrush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffset0000FF}"  Color="{Binding Color0000FFBrush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffsetFF00FF}"  Color="{Binding ColorFF00FFBrush,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <GradientStop Offset="{Binding GradientOffsetFF00002}" Color="{Binding ColorFF0000Brush2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Slider x:Name="gradientSlider"
                                    Foreground="White"
                                    IsTabStop="False"
                                    Maximum="{Binding MAX_GRADIENT_SLIDER}"
                                    Minimum="0"
                                    Orientation="Horizontal"
                                    Style="{StaticResource colorSliderStyle}"
                                    TickFrequency="1"
                                    Value="{Binding SelectedHue}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- セパレーター -->
                        <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>

                        <!-- ═══ メインエリア ═══ -->
                        <Grid Grid.Row="2" Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左カラム: RGB / HEX / プレビュー -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- RGB スライダー行 -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- R -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="11" Foreground="Red"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="2,1"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Right"
                                             att:TextBoxEx.IsClearButtonShow="False"
                                             Text="{Binding SelectedRed, UpdateSourceTrigger=LostFocus}"/>
                                    <Slider Grid.Row="0" Grid.Column="2" Margin="4,0,0,0"
                                            Foreground="Red"
                                            Style="{StaticResource colorSelectorSliderStyle}"
                                            Value="{Binding SelectedRed, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- G -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="11" Foreground="Green"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="2,1"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Right"
                                             att:TextBoxEx.IsClearButtonShow="False"
                                             Text="{Binding SelectedGreen}"/>
                                    <Slider Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                            Foreground="Green"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            Style="{StaticResource colorSelectorSliderStyle}"
                                            Value="{Binding SelectedGreen, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- B -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="11" Foreground="Blue"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="2,1"
                                             VerticalContentAlignment="Center"
                                             TextAlignment="Right"
                                             att:TextBoxEx.IsClearButtonShow="False"
                                             Text="{Binding SelectedBlue}"/>
                                    <Slider Grid.Row="2" Grid.Column="2" Margin="4,0,0,0"
                                            Foreground="Blue"
                                            Style="{StaticResource colorSelectorSliderStyle}"
                                            Value="{Binding SelectedBlue, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- HEX 入力 -->
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Margin="2,0,0,0"
                                             VerticalContentAlignment="Center"
                                             att:TextBoxEx.IsClearButtonShow="False"
                                             Text="{Binding HexColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 新旧カラープレビュー -->
                                <Border Grid.Row="2" Margin="0,6,6,0"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        ClipToBounds="True"
                                        MinHeight="40">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="{Binding SelectedColor, Converter={StaticResource colorToSolidBrushConverter}, ConverterParameter=Colors.Red}"/>
                                        <Border Grid.Row="1"
                                                Background="{Binding OldColor, Converter={StaticResource colorToSolidBrushConverter}, ConverterParameter=Colors.Transparent}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 縦区切り -->
                            <Border Grid.Column="1" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Margin="6,0"/>

                            <!-- 右カラム: A / S / L -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- ヘッダー -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="A"
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="S"
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="L"
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

                                <!-- テキストボックス -->
                                <TextBox Grid.Row="1" Grid.Column="0" Margin="1,1"
                                         HorizontalContentAlignment="Right"
                                         att:TextBoxEx.IsClearButtonShow="False"
                                         Text="{Binding SelectedA}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="1,1"
                                         HorizontalContentAlignment="Right"
                                         att:TextBoxEx.IsClearButtonShow="False"
                                         Text="{Binding SelectedSaturation, StringFormat='0.00'}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="1,1"
                                         HorizontalContentAlignment="Right"
                                         att:TextBoxEx.IsClearButtonShow="False"
                                         Text="{Binding SelectedLightness, StringFormat='0.00'}"/>

                                <!-- 垂直スライダー (グラデーション背景付き) -->
                                <!-- A -->
                                <Slider Grid.Row="2" Grid.Column="0"
                                        Style="{StaticResource colorSelectorVSliderStyle}"
                                        Value="{Binding SelectedA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- S: グラデーション + スライダー -->
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Border VerticalAlignment="Stretch" Width="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0"   Color="{Binding ColorMaxSaturation,    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <GradientStop Offset="0.5" Color="{Binding ColorMediumSaturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <GradientStop Offset="1"   Color="{Binding ColorMinSaturation,    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Slider Foreground="#3D3D3D"
                                            Style="{StaticResource colorSelectorVdoubleSliderStyle}"
                                            Value="{Binding SelectedSaturation, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- L: グラデーション + スライダー -->
                                <Grid Grid.Row="2" Grid.Column="2">
                                    <Border VerticalAlignment="Stretch" Width="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0"   Color="{Binding ColorMaxBrightness,    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <GradientStop Offset="0.5" Color="{Binding ColorMediumBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <GradientStop Offset="1"   Color="{Binding ColorMinBrightness,    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Slider Foreground="#3D3D3D"
                                            Style="{StaticResource colorSelectorVdoubleSliderStyle}"
                                            Value="{Binding SelectedLightness, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
