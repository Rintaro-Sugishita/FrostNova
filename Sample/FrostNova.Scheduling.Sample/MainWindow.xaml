<Window x:Class="FrostNova.Scheduling.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrostNova.Scheduling.Sample"
        xmlns:chart="clr-namespace:FrostNova.TimeRangeChart.Wpf;assembly=FrostNova.TimeRangeChart.Wpf"
        Title="スケジューリング確認サンプル" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converters must be defined before templates that reference them -->
        <local:CountToForegroundConverter x:Key="CountToForegroundConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Footer column: task count per time column -->
        <DataTemplate x:Key="FooterColumnTemplate" DataType="{x:Type local:FooterColumnViewModel}">
            <Border BorderBrush="Gray" BorderThickness="0,1,1,0" Background="#F5F5F5">
                <TextBlock Text="{Binding TaskCount}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{Binding TaskCount, Converter={StaticResource CountToForegroundConverter}}"/>
            </Border>
        </DataTemplate>

        <!-- Footer corner label template -->
        <DataTemplate x:Key="FooterCornerTemplate">
            <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Background="#EBEBEB">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="10" Foreground="#555"/>
            </Border>
        </DataTemplate>

        <!-- Slider label style -->
        <Style x:Key="EffLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="EffValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="32"/>
        </Style>

        <!-- スコアセルのテンプレート: Eligible=trueならスライダー、falseなら「—」 -->
        <!-- Step0 (成形) -->
        <DataTemplate x:Key="ScoreCell0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[0]}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Slider Value="{Binding Step0Score, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="3.0" Width="68" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Step0Score, StringFormat='x{0:F1}'}" Width="32" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[0]}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <!-- Step1 (加工) -->
        <DataTemplate x:Key="ScoreCell1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[1]}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Slider Value="{Binding Step1Score, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="3.0" Width="68" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Step1Score, StringFormat='x{0:F1}'}" Width="32" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[1]}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <!-- Step2 (品検) -->
        <DataTemplate x:Key="ScoreCell2">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[2]}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Slider Value="{Binding Step2Score, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="3.0" Width="68" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Step2Score, StringFormat='x{0:F1}'}" Width="32" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[2]}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <!-- Step3 (仕上) -->
        <DataTemplate x:Key="ScoreCell3">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[3]}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Slider Value="{Binding Step3Score, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="3.0" Width="68" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Step3Score, StringFormat='x{0:F1}'}" Width="32" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eligible[3]}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <TabControl>
            <!-- ═══ Scenario A: 製造ラインスケジューリング ═══ -->
            <TabItem Header="A: 製造ライン（5製品×4工程・ライン制限あり）">
                <DockPanel DataContext="{Binding ScenarioA}">

                    <!-- コントロールパネル -->
                    <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel>
                            <!-- 1行目: 実行ボタン + 探索方法 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="▶ スケジューリング実行" Command="{Binding RunSchedulingCommand}"
                                        Padding="14,5" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0">最適化:</TextBlock>
                                <ComboBox SelectedValue="{Binding SelectedStrategy}" SelectedValuePath="Tag"
                                          Width="170" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <ComboBoxItem Content="最適化なし（1回のみ）" Tag="none"/>
                                    <ComboBoxItem Content="全探索（≤8品推奨）" Tag="exhaustive"/>
                                    <ComboBoxItem Content="ランダム探索" Tag="random"/>
                                    <ComboBoxItem Content="遺伝的アルゴリズム" Tag="ga"/>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0">試行回数/世代数:</TextBlock>
                                <TextBox Text="{Binding Iterations, UpdateSourceTrigger=PropertyChanged}"
                                         Width="50" VerticalAlignment="Center" Margin="0,0,16,0"
                                         VerticalContentAlignment="Center" Padding="3,2"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#555"
                                           Text="加工: Line_A・B のみ  /  仕上: Line_B・C のみ"/>
                            </StackPanel>
                            <!-- 2行目: スコア重み + 結果 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0">スコア重み —</TextBlock>
                                <TextBlock Text="A(納期ズレ)" Style="{StaticResource EffLabel}"/>
                                <Slider Value="{Binding WeightA, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="0" Maximum="5" Width="80" VerticalAlignment="Center" TickFrequency="0.5"/>
                                <TextBlock Text="{Binding WeightA, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="D(稼働バランス)" Style="{StaticResource EffLabel}"/>
                                <Slider Value="{Binding WeightD, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="0" Maximum="5" Width="80" VerticalAlignment="Center" TickFrequency="0.5"/>
                                <TextBlock Text="{Binding WeightD, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="{Binding LastScoreText}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#1a6a1a" FontWeight="SemiBold"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                            <!-- 工程×ラインのスコアマトリクス -->
                            <DataGrid ItemsSource="{Binding LineScores}"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                      RowHeaderWidth="0" BorderThickness="1" GridLinesVisibility="All"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                      SelectionMode="Single" SelectionUnit="Cell"
                                      Margin="0,2,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ライン" Binding="{Binding LineName}" IsReadOnly="True" Width="62"/>
                                    <DataGridTemplateColumn Header="成形" Width="108" CellTemplate="{StaticResource ScoreCell0}"/>
                                    <DataGridTemplateColumn Header="加工" Width="108" CellTemplate="{StaticResource ScoreCell1}"/>
                                    <DataGridTemplateColumn Header="品検" Width="108" CellTemplate="{StaticResource ScoreCell2}"/>
                                    <DataGridTemplateColumn Header="仕上" Width="108" CellTemplate="{StaticResource ScoreCell3}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <chart:GridTimeRangeChart
                        x:Name="ChartA"
                        DockPanel.Dock="Bottom"
                        ItemsSource="{Binding ResultRows}"
                        TasksSourcePath="Tasks"
                        NonWorkingTimes="{Binding NonWorkingTimes}"
                        StartTime="{Binding ChartStart}"
                        EndTime="{Binding ChartEnd}"
                        ScaleIncrement="1:0:0"
                        SubScaleIncrement="0:30:0"
                        HeaderFormat="HH:mm"
                        WidthPerRuledLine="80"
                        ChartHeight="40"
                        StackHeight="32"
                        MinRowWidth="110"
                        CanStackRange="False"
                        CanDragTasksBetweenRows="False"
                        FooterHeight="28"
                        FooterItemsSource="{Binding FooterItems}"
                        FooterTemplate="{StaticResource FooterColumnTemplate}"
                        FooterCornerSource="タスク数"
                        FooterCornerTemplate="{StaticResource FooterCornerTemplate}"
                        TaskDragEnd="ChartA_TaskDragEnd">
                        <chart:GridTimeRangeChart.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TeamName}" VerticalAlignment="Center"
                                           Margin="8,0" FontSize="12"/>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.RowHeaderTemplate>
                        <chart:GridTimeRangeChart.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ScheduledTask}">
                                <Border Background="{Binding Color}" CornerRadius="2" Margin="1,2">
                                    <TextBlock Text="{Binding PhaseLabel}"
                                               Foreground="White" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Padding="3,0" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.ItemTemplate>
                    </chart:GridTimeRangeChart>
                </DockPanel>
            </TabItem>

            <!-- ═══ Scenario B: ウォーターフォール開発（2プロジェクト競合） ═══ -->
            <TabItem Header="B: ウォーターフォール（α/βプロジェクト競合）">
                <DockPanel DataContext="{Binding ScenarioB}">

                    <!-- コントロールパネル -->
                    <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="▶ スケジューリング実行" Command="{Binding RunSchedulingCommand}"
                                        Padding="14,5" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#555"
                                           Text="α（優先度高）・β（優先度低）が同一チームを共有  →  効率↑でα完了が早まりβ開始も前倒し"/>
                            </StackPanel>
                            <!-- チーム効率スライダー -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="チーム効率:" Style="{StaticResource EffLabel}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBlock Text="PM" Style="{StaticResource EffLabel}"/>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding TeamPmEfficiency}" Width="100"
                                        TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TeamPmEfficiency, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="Design" Style="{StaticResource EffLabel}"/>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding TeamDesignEfficiency}" Width="100"
                                        TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TeamDesignEfficiency, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="FE" Style="{StaticResource EffLabel}"/>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding TeamFeEfficiency}" Width="100"
                                        TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TeamFeEfficiency, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="BE" Style="{StaticResource EffLabel}"/>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding TeamBeEfficiency}" Width="100"
                                        TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TeamBeEfficiency, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                                <TextBlock Text="QA" Style="{StaticResource EffLabel}"/>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding TeamQaEfficiency}" Width="100"
                                        TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TeamQaEfficiency, StringFormat='x{0:F1}'}" Style="{StaticResource EffValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <chart:GridTimeRangeChart
                        x:Name="ChartB"
                        DockPanel.Dock="Bottom"
                        ItemsSource="{Binding ResultRows}"
                        TasksSourcePath="Tasks"
                        NonWorkingTimes="{Binding NonWorkingTimes}"
                        StartTime="{Binding ChartStart}"
                        EndTime="{Binding ChartEnd}"
                        ScaleIncrement="1.00:00:00"
                        HeaderFormat="MM/dd"
                        WidthPerRuledLine="40"
                        ChartHeight="40"
                        StackHeight="32"
                        MinRowWidth="110"
                        CanStackRange="False"
                        CanDragTasksBetweenRows="False"
                        FooterHeight="28"
                        FooterItemsSource="{Binding FooterItems}"
                        FooterTemplate="{StaticResource FooterColumnTemplate}"
                        FooterCornerSource="タスク数"
                        FooterCornerTemplate="{StaticResource FooterCornerTemplate}"
                        TaskDragEnd="ChartB_TaskDragEnd">
                        <chart:GridTimeRangeChart.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TeamName}" VerticalAlignment="Center"
                                           Margin="8,0" FontSize="12"/>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.RowHeaderTemplate>
                        <chart:GridTimeRangeChart.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ScheduledTask}">
                                <Border Background="{Binding Color}" CornerRadius="2" Margin="1,2">
                                    <TextBlock Text="{Binding PhaseLabel}"
                                               Foreground="White" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Padding="3,0" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.ItemTemplate>
                    </chart:GridTimeRangeChart>
                </DockPanel>
            </TabItem>

            <!-- ═══ Scenario C: 大量データ ベンチマーク ═══ -->
            <TabItem Header="C: 大量データ（1000タスク×30設備×100日）">
                <DockPanel DataContext="{Binding ScenarioC}">

                    <!-- コントロールパネル -->
                    <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel>
                            <!-- 問題サイズ -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="タスク数" Style="{StaticResource EffLabel}" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding TaskCount}" Width="56" VerticalContentAlignment="Center"/>
                                <TextBlock Text="設備数" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding LineCount}" Width="44" VerticalContentAlignment="Center"/>
                                <TextBlock Text="期間(日)" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding HorizonDays}" Width="44" VerticalContentAlignment="Center"/>
                                <TextBlock Text="製品あたり工程数" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding StepsPerProduct}" Width="34" VerticalContentAlignment="Center"/>
                                <TextBlock Text="時間単位(h)" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding UnitHours}" Width="34" VerticalContentAlignment="Center"
                                         ToolTip="スケジューリングの最小刻み。1 が最も精密で最も遅い。4 にすると約 4 倍速くなる。"/>
                            </StackPanel>

                            <!-- 実行設定 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="▶ ベンチマーク実行" Command="{Binding RunBenchmarkCommand}"
                                        Padding="14,5" FontWeight="Bold" Margin="0,0,16,0"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="探索:" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <ComboBox SelectedValue="{Binding SelectedStrategy}" SelectedValuePath="Tag" Width="150" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="最適化なし（1回）" Tag="none"/>
                                    <ComboBoxItem Content="ランダム探索" Tag="random" IsSelected="True"/>
                                    <ComboBoxItem Content="遺伝的アルゴリズム" Tag="ga"/>
                                </ComboBox>
                                <TextBlock Text="試行回数" Style="{StaticResource EffLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Iterations}" Width="44" VerticalContentAlignment="Center"/>
                                <CheckBox Content="日別効率を使う" IsChecked="{Binding UseDailyEfficiency}"
                                          VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
                                <CheckBox Content="ガントチャートに描画" IsChecked="{Binding RenderChart}"
                                          VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <!-- 指標テーブル -->
                            <Border BorderBrush="#CCC" BorderThickness="1" Background="White" Padding="0">
                                <ItemsControl ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:BenchmarkMetricRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" Padding="6,2"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Baseline}" FontSize="11" Padding="6,2" Foreground="#555"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Optimized}" FontSize="11" Padding="6,2" FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="ベースライン（最適化なし）" FontSize="10" Foreground="#888" Padding="6,0"/>
                                <TextBlock Grid.Column="2" Text="最適化後" FontSize="10" Foreground="#888" Padding="6,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <chart:GridTimeRangeChart
                        x:Name="ChartC"
                        DockPanel.Dock="Bottom"
                        ItemsSource="{Binding ResultRows}"
                        TasksSourcePath="Tasks"
                        NonWorkingTimes="{Binding NonWorkingTimes}"
                        StartTime="{Binding ChartStart}"
                        EndTime="{Binding ChartEnd}"
                        ScaleIncrement="1.00:00:00"
                        HeaderFormat="MM/dd"
                        WidthPerRuledLine="16"
                        ChartHeight="18"
                        StackHeight="14"
                        MinRowWidth="60"
                        CanStackRange="False"
                        CanDragTasksBetweenRows="False"
                        FooterHeight="22"
                        FooterItemsSource="{Binding FooterItems}"
                        FooterTemplate="{StaticResource FooterColumnTemplate}"
                        FooterCornerSource="タスク数"
                        FooterCornerTemplate="{StaticResource FooterCornerTemplate}"
                        TaskDragEnd="ChartC_TaskDragEnd">
                        <chart:GridTimeRangeChart.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TeamName}" VerticalAlignment="Center"
                                           Margin="6,0" FontSize="10"/>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.RowHeaderTemplate>
                        <chart:GridTimeRangeChart.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ScheduledTask}">
                                <Border Background="{Binding Color}" CornerRadius="1" Margin="0,1"
                                        ToolTip="{Binding PhaseLabel}"/>
                            </DataTemplate>
                        </chart:GridTimeRangeChart.ItemTemplate>
                    </chart:GridTimeRangeChart>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
